<script>
    $(function () {
        document.getElementById("NumberofCharges").addEventListener("keypress", function (event) {
            const char = String.fromCharCode(event.keyCode || event.which);
            const newValue = this.value + char;
            if (!/^\d+$/.test(char) || Number(newValue) > 100 || newValue.length > 3) {
                event.preventDefault();
            }
        });

        $("#NumberofCharges").change(function () {
            var value = document.getElementById("NumberofCharges").value;
            var container = document.getElementById("container");
            container.innerHTML = "";
            var num = parseInt(value);
            if (num > 100) {
                return false;
            }

            for (var i = 1; i <= num; i++) {
                // Create label
                var label = document.createElement("label");
                label.innerHTML = "आरोप का विवरण " + i + ":";

                // Create textarea
                var textarea = document.createElement("textarea");
                textarea.name = "Vivradh";
                textarea.className = "form-control col-sm-12"; // Added col-sm-12 class
                textarea.id = "Vivradh_" + i;
                textarea.rows = 6;

                // Create a div wrapper for proper spacing
                var wrapper = document.createElement("div");
                wrapper.className = "form-group";

                // Append label and textarea to wrapper
                wrapper.appendChild(label);
                wrapper.appendChild(textarea);

                // Append wrapper to container
                container.appendChild(wrapper);
            }
        });
    });

    function filechange1() {
        var fileInput = $("#ChargeSheetAttachment")[0];
        if (fileInput.files.length > 0) {
            var file = fileInput.files[0];
            var allowedFileTypes = ["application/pdf"];
            if (allowedFileTypes.indexOf(file.type) === -1) {
                showErrorNotification("कृपया केवल PDF फ़ाइल अपलोड करें!.");
                fileInput.value = ""; // Clear the file input
                return false;
            }
            var maxSizeInBytes = 5 * 1024 * 1024; // 5 MB limit (adjust as needed)
            if (file.size > maxSizeInBytes) {
                showErrorNotification("फ़ाइल का Size 5 MB की स्वीकृत सीमा से अधिक है। कृपया एक छोटी फ़ाइल चुनें.");
                fileInput.value = ""; // Clear the file input
                return false;
            }
        }
    }

    function SaveAaropDetails(event) {

        var button = $(event); // Use `event` directly as `this` from onclick
        button.prop("disabled", true).text("Loading..."); // Disable button and show loading text

        var valid = true;
        var ChargeSheetNumber = $("#ChargeSheetNumber").val().trim();
        var ChargeSheetAttachment = $("#ChargeSheetAttachment").val();
        var DateOfIssueChargeSheet = $("#DateOfIssueChargeSheet").val();
        var NumberofCharges = $("#NumberofCharges").val();

        if (ChargeSheetNumber == "") {
            ErrorMessagefun("आरोप पत्र संख्या भरें !", "ChargeSheetNumber");
            button.prop("disabled", false).text("सेव करें"); // Re-enable button
            return false;
        }
        if (ChargeSheetAttachment == "") {
            ErrorMessagefun("आरोप पत्र अपलोड करें !", "ChargeSheetAttachment");
            button.prop("disabled", false).text("सेव करें");
            return false;
        }
        if (DateOfIssueChargeSheet == "") {
            ErrorMessagefun("आरोप पत्र निर्गत की तिथि भरें !", "DateOfIssueChargeSheet");
            button.prop("disabled", false).text("सेव करें");
            return false;
        }
        if (NumberofCharges == "") {
            ErrorMessagefun("आरोपों की संख्या भरें !", "NumberofCharges");
            button.prop("disabled", false).text("सेव करें");
            return false;
        }

        var errorMessage = document.getElementById("error-message");
        errorMessage.textContent = "";

        var inputs = document.querySelectorAll('textarea[name="Vivradh"]');
        inputs.forEach(function (input) {
            if (input.value.trim() === "") {
                errorMessage.textContent = "All text fields must be filled.";
                input.style.border = "1px solid red";
                valid = false;
            } else {
                input.style.border = "";
            }
        });

        if (!valid) {
            button.prop("disabled", false).text("सेव करें");
            return false;
        }

        let VivradhArr = [];
        $("textarea[name='Vivradh']").each(function () {
            let description = $(this).val().trim();
            if (description !== "") {
                VivradhArr.push({ AaropDescription: description });
            }
        });

        let formData = new FormData();
        formData.append("ComplaintNumber", $("#hiddenComplain_number").val());
        formData.append("AaropDescriptions", JSON.stringify(VivradhArr));
        formData.append("ChargeSheetNumber", ChargeSheetNumber);
        formData.append("ChargeSheetAttachmentDoc", $("#ChargeSheetAttachment")[0].files[0]);
        formData.append("DateOfIssueChargeSheet", DateOfIssueChargeSheet);
        formData.append("NumberofCharges", NumberofCharges);
        formData.append("ComplainantName", $("input[type='text'][name='ComplainantName']").val());
        formData.append("InspEmailId", $("input[type='text'][id='InvestigatingOfficerName']").val());
        $.ajax({
            url: "/ComplaintSE/AddComplaintdAarop",
            type: "POST",
            contentType: false,
            processData: false,
            data: formData,
            success: function (response) {
                toastr.options = {
                    closeButton: true,
                    timeOut: 1000,
                    progressBar: true,
                    positionClass: "toast-top-right"
                };
                toastr.success(response);

                setTimeout(function () {
                    window.location.reload();
                }, 2000);
            },
            error: function () {
                toastr.options = {
                    closeButton: true,
                    timeOut: 1000,
                    progressBar: true,
                    positionClass: "toast-top-right"
                };
                toastr.error('एरर!');
            },
            complete: function () {
                button.prop("disabled", false).text("सेव करें"); // Re-enable button
            }
        });
    }

</script>
