<script type="text/javascript">

    $(document).ready(function () {
        var msg = '@TempData["msg"]';
        if (msg == "Update") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.success('डेटा सफलतापूर्वक अपडेट हो गया!');
        }
        else if (msg == "error") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.error('एरर!');
        }
        else if (msg == "inserted") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.success('डेटा सफलतापूर्वक सेव हो गया!');
        }
        $('#appealdiv,#Revisiondiv').hide();
        $('#lastupdatedate').hide();
        $('#FinalStatusdiv1').hide();
        $('#AddCourtCasediv').hide();
        $('#AddContemtCasediv').hide();
        $('#AddInvestigationdiv').hide();
        $('#Appealfinalstatusdiv').hide();
        $('#lastupdateForwardingdate').hide();
        $('#remarkdiv,#FinalStatusdiv').hide();
        $('#forwarddiv').hide();
        $('#Againforwarddiv').hide();
        $('#OtherRemarkSubjectdiv').hide();
        $('#MarkedZonediv,#Markedcirclediv,#Markeddivisiondiv,#Aaropdiv').hide();
        bindDesignationsMarkedOfficer('ForwadingOfficerDesignations', -1, -1);
        bindDesignationsMarkedOfficerAppeal('AppealForwadingOfficerDesignations', -1, -1);
        bindDesignationsMarkedOfficerRevision('RevisionForwadingOfficerDesignations', -1, -1);
        bindDesignationsCourtCase('CourtCaseDrop', -1, -1);
        bindDesignationsInvestigationAgency('InvestigationId', -1, -1);

        bindInspZone('MarkedZoneId', -1);
        bindInspCircle('MarkedCircleId', -1, -1);
        bindInspDivision('MarkeddivisionId', -1, -1, -1);
        bindInspUserTypeRoles('MarkToInspRoleType', -1);
        bindInspOfficerDesignations('InvestigatingOfficerDesignation', -1, -1);
        $('#ComplaintRemarkSubjects').change(function () {
            if ($('#ComplaintRemarkSubjects').val() == '8') {
                $('#OtherRemarkSubjectdiv').show();
            }
            else {
                $('#OtherRemarkSubjectdiv').hide();
            }
        });
        $('#addforwardingofficer').click(function () {

            const myDiv = document.getElementById('forwarddiv');
            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
            }
            $('#AddCourtCasediv').hide();
            $('#remarkdiv').hide();
            $('#Againforwarddiv').hide();
            $('#ForwardOfficerDate1').val('');
            $('#ForwardingOfficerLetterNo1').val('');
            $('#ForwardingMarkToRoleType').val('HQ');

            bindDesignationsMarkedOfficer('ForwadingOfficerDesignations', -1, -1);

        });
        $('#addFinalStatus').click(function () {
            const myDiv = document.getElementById('FinalStatusdiv');


            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
                $("input[type='checkbox'][name='FinalStatus']").prop("checked", false).trigger('change');
            }
            $('#AddCourtCasediv').hide();
            $('#remarkdiv').hide();
            $('#forwarddiv').hide();
            $('#FinalStatusdiv1').hide();
        });

        $('#addcourtcase').click(function () {
            const myDiv = document.getElementById('AddCourtCasediv');
            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
                $("input[type='checkbox'][name='FinalStatus']").prop("checked", false).trigger('change');
            }

            $('#Againforwarddiv').hide();
            $('#remarkdiv').hide();
            $('#forwarddiv').hide();
            $('#FinalStatusdiv1').hide();
            $('#AddInvestigationdiv').hide();
        });

        $('#addcontemtcase').click(function () {
            const myDiv = document.getElementById('AddContemtCasediv');
            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
                $("input[type='checkbox'][name='FinalStatus']").prop("checked", false).trigger('change');
            }

            $('#remarkdiv').hide();
            $('#forwarddiv').hide();
            $('#FinalStatusdiv1').hide();
            $('#AddInvestigationdiv').hide();
            $('#AddCourtCasediv').hide();
        });
        $('#addinvestigation').click(function () {
            const myDiv = document.getElementById('AddInvestigationdiv');

            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
                $("input[type='checkbox'][name='FinalStatus']").prop("checked", false).trigger('change');
            }

            $('#remarkdiv').hide();
            $('#forwarddiv').hide();
            $('#AddCourtCasediv').hide();
        });
        $('#addFinalStatus1').click(function () {
            const myDiv = document.getElementById('FinalStatusdiv1');


            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
                $("input[type='checkbox'][name='FinalStatus']").prop("checked", false).trigger('change');
            }

            $('#remarkdiv').hide();
            $('#forwarddiv').hide();
        });

        $('#addFinalAppealStatus').click(function () {
            const myDiv = document.getElementById('Appealfinalstatusdiv');


            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
                $("input[type='checkbox'][name='FinalStatus']").prop("checked", false).trigger('change');
            }

            $('#remarkdiv').hide();
            $('#forwarddiv').hide();
        });
        $('#remarkbutton').click(function () {
