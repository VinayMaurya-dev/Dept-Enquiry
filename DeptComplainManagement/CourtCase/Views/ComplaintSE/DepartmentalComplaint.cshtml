    $("#InvestigatingOfficerDesignationId").change(function () {

        var DesignationId = $(this).val();
        if (DesignationId == "-1") {
            $("#InvestigatingOfficerName").val('');
            $("#InvestigatingOfficerMobile").val('');
        } else {
            var RoleTypeId = $('#InvestigatingOfficerRelatedTo').val();
            var ZoneId = $('#InvestigatingOfficerZoneId').val();
            var CircleId = $('#InvestigatingOfficerCircleId').val();
            var DivisionId = $('#InvestigatingOfficerDivisionId').val();
            bindInspOfficerName('InvestigatingOfficerName', -1, DesignationId, RoleTypeId, ZoneId, CircleId, DivisionId);
        }

    });
    $("#AffiliatedOfficesRelatedTo").change(function () {
        var RoleTypeId = $(this).val();
        if (RoleTypeId == "HQ") {
            bindAffiliatedOfficerDesignations('AffiliatedOfficesDesignationId', -1, RoleTypeId);
            $("#AffiliatedOfficesDiv").show();
        } else {
            bindAffiliatedOfficerDesignations('AffiliatedOfficesDesignationId', -1, -1);
            $("#AffiliatedOfficesDiv").hide();
        }
    });
    function bindInspOfficerName(id, defaultSelectionValues, DesignationId, RoleTypeId, ZoneId, CircleId, DivisionId) {
        defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
        if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
            defaultSelectionValues = '-1';
        }
        $('#InvestigatingOfficerName').val('');
        $('#InvestigatingOfficerMobile').val('');
        $('#InvestigatingOfficerUser_Number').val('');
        var obj = new Object();
        obj.Action = "bindInspOfficerProfile";
        obj.RoleTypeId = RoleTypeId;
        obj.ZoneId = ZoneId;
        obj.CircleId = CircleId;
        obj.DivisionId = DivisionId;
        obj.DesignationId = DesignationId;
        $.ajax({
            type: 'POST',
            url: '/DropdownBinder/fillDropdownData',
            data: obj,
            success: function (Data) {
                var res = Data[0];
                if (res == null || res == '' || res == undefined) {
                    $('#InvestigatingOfficerName').val('');
                    $('#InvestigatingOfficerMobile').val('');
                    $('#InvestigatingOfficerUser_Number').val('');
                }
                else {
                    $('#InvestigatingOfficerName').val(res.value);
                    $('#InvestigatingOfficerMobile').val(res.id);
                    $('#InvestigatingOfficerUser_Number').val(res.UserNumber);
                }
            },
            error: function (errorData) {
                console.log(errorData);
            }
        });
    }

