    function filechange() {
        var fileInput = $("#Attachment")[0];
        if (fileInput.files.length > 0) {
            var file = fileInput.files[0];
            var allowedFileTypes = ["application/pdf"];
            if (allowedFileTypes.indexOf(file.type) === -1) {
                showErrorNotification("कृपया केवल PDF फ़ाइल अपलोड करें!.");
                fileInput.value = ""; // Clear the file input
                return false;
            }
            var maxSizeInBytes = 5 * 1024 * 1024; // 5 MB limit (adjust as needed)
            if (file.size > maxSizeInBytes) {
                showErrorNotification("फ़ाइल का Size 5 MB की स्वीकृत सीमा से अधिक है। कृपया एक छोटी फ़ाइल चुनें.");
                fileInput.value = ""; // Clear the file input
                return false;
            }
        }
    }
    function Validate() {

        var R_U = $("#R_U").val();
        if (R_U == "-1") {
            showErrorNotification("ग्रामीण / नगरीय चुनें ");
            $("#R_U").focus();
            return false;
        }

        var ComplaintEnquiryType = $("#ComplaintEnquiryType").val();
        if (ComplaintEnquiryType == "-1") {
            showErrorNotification("विभागीय जांच किनके द्वारा आरंभ की गई");
            $("#ComplaintEnquiryType").focus();
            return false;
        }

        var EmployeeId = $("#EmployeeId").val();
        if (EmployeeId == "") {
            showErrorNotification("कार्मिक का पहचान संख्या डालें");
            $("#EmployeeId").focus();
            return false;
        }

        var ComplainantName = $("#ComplainantName").val();
        if (ComplainantName == "") {
            showErrorNotification("कार्मिक का नाम (जिसके खिलाफ शिकायत दर्ज है)");
            $("#ComplainantName").focus();
