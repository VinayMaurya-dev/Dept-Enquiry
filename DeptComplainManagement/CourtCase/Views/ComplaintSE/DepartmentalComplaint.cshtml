@model CourtCase.Models.ComplaintDetails
@{
    ViewBag.Title = "DepartmentalComplaint";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .toast-top-right {
        top: 12px;
    }
</style>
<script src="https://unpkg.com/pdf-lib@1.11.0/dist/pdf-lib.min.js"></script>
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
<div class="app-main__inner">
    <div class="app-page-title app-page-title-simple">
        <div class="page-title-wrapper">
            <div class="page-title-heading">
                <div>
                    <div class="page-title-head center-elem">
                        <span class="d-inline-block pr-2">
                            <i class="lnr-apartment opacity-6"></i>
                        </span>
                        <span class="d-inline-block">Departmental Enquiry</span>
                    </div>
                    <div class="page-title-subheading opacity-10">
                        <nav class="" aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <button type="button" onclick="history.back()" value="BACK" class="btn btn-primary mybackbutton"><i class="fa fa-arrow-left" aria-hidden="true"> Back</i></button>
                                </li>

                                <li class="active breadcrumb-item" aria-current="page">
                                    विभागीय जाँच
                                </li>
                            </ol>
                        </nav>

                    </div>

                </div>
            </div>

        </div>
    </div>

    <div class="main-card mb-3 card">
        <div class="card-body">
            @using (Html.BeginForm("DepartmentalComplaint", "ComplaintSE", FormMethod.Post, new { encType = "multipart/form-data" }))
            {
                <div class="vertical-without-time vertical-timeline--animate vertical-timeline--one-column">
                    <div class="vertical-timeline-item vertical-timeline-element">
                        <div>
                            <span class="vertical-timeline-element-icon bounce-in">
                                <i class="badge badge-dot badge-dot-xl badge-success"> </i>
                            </span>
                            <div class="float-right text-muted small"><span style="color:red;" class="blink"><i class="fa fa-warning"></i>All fields Mandatory</span></div>
                            <div class="vertical-timeline-element-content bounce-in">
                                <h3 class="timeline-title">अपचारी का विवरण</h3>

                                <br />

                                <div class="form-row">
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">
                                                ग्रामीण / नगरीय
                                            </label><br />

                                            <select class="form-control" id="R_U" name="R_U">
                                                <option value="-1">Choose Option</option>
                                                <option value="Rural">Rural</option>
                                                <option value="Urban">Urban</option>

                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">
                                                विभागीय जांच किनके द्वारा आरंभ की गई
                                            </label><br />

                                            <select class="form-control" id="ComplaintEnquiryType" name="ComplaintEnquiryType">
                                                <option value="-1">Choose Option</option>
                                                <option value="Board Of Directors, U.P. Jal Nigam (Rural)">Board Of Directors, U.P. Jal Nigam (Rural)</option>
                                                <option value="Chairman, U.P. Jal Nigam (Rural)">Chairman, U.P. Jal Nigam (Rural)</option>
                                                <option value="Managing Director,  U.P. Jal Nigam (Rural)">Managing Director,  U.P. Jal Nigam (Rural)</option>
                                                <option value="Finance Director, U.P. Jal Nigam (Rural)">Finance Director, U.P. Jal Nigam (Rural)</option>
                                                <option value="Chief Engineer(अ-2-1)">Chief Engineer(अ-2-1)</option>
                                                <option value="Chief Engineer(अ-2-2)">Chief Engineer(अ-2-2)</option>
                                                <option value="Chief Engineer(अ-3)">Chief Engineer(अ-3)</option>
                                                <option value="Chief Engineer(अ-4)">Chief Engineer(अ-4)</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class=""> कार्मिक का विभागीय कोड </label><br />
                                            @Html.TextBoxFor(m => m.EmployeeId, new { @class = "form-control", @lang = "hii", @ID = "EmployeeId" })
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">कार्मिक का नाम (जिसके खिलाफ शिकायत दर्ज है)</label><br />
                                            @Html.TextBoxFor(m => m.ComplainantName, new { @class = "form-control", @lang = "hii" })
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">कार्मिक का मोबाइल नंबर</label><br />
                                            @Html.TextBoxFor(m => m.MobileNo, new { @class = "form-control", @id = "MobileNo", maxlength = "10", oninput = "validateNumberInput(this)" })

                                        </div>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">कार्मिक का ईमेल आईडी</label><br />
                                            @Html.TextBoxFor(m => m.EmailId, new { @class = "form-control", @id = "EmailId" })
                                        </div>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">वर्तमान कार्यरत कार्यालय </label>
                                            <select class="form-control" id="ComplaintRelatedTo" name="ComplaintRelatedTo"></select>
                                        </div>
                                    </div>

                                    <div class="col-md-4 mb-3" id="zoneddl">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">वर्तमान ज़ोन </label>

                                            <select class="form-control zone" id="ComplaintRelatedZoneId" name="ComplaintRelatedZoneId"></select>
                                        </div>

                                    </div>

                                    <div class="col-md-4 mb-3" id="circleddl">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">वर्तमान सर्किल </label>
                                            <select class="form-control circle" id="ComplaintRelatedCircleId" name="ComplaintRelatedCircleId"></select>

                                        </div>

                                    </div>
                                    <div class="col-md-4 mb-3" id="ddldivision">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">वर्तमान डिवीज़न </label>
                                            <select class="form-control" id="ComplaintRelatedDivisionId" name="ComplaintRelatedDivisionId"></select>

                                        </div>

                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">वर्तमान पदनाम</label><br />
                                            <select class="form-control" id="ComplainRelatedDesignationId" name="ComplainRelatedDesignationId"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">जांच संस्थित किये जाने की  पत्रावली संख्या</label>
                                            @Html.TextBoxFor(m => m.OfficeMemorandumNumber, new { @class = "form-control", @id = "OfficeMemorandumNumber" })
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">जांच संस्थित किये जाने का दिनांक</label>
                                            @Html.TextBoxFor(m => m.OfficeMemorandumDate, new { @class = "form-control", @data_toggle = "datepicker-month", @autocomplete = "off", @placeholder = "MM/DD/YYYY", @maxlength = "10", @id = "OfficeMemorandumDate" })
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">

                                        <div class="position-relative form-group">
                                            <label for="validationCustom05">डॉक्यूमेंट अपलोड(नियुक्ति अधिकारी का पत्र)</label>

                                            @Html.TextBoxFor(m => m.Attachment, new { @class = "form-control Attachment", @type = "file", @id = "Attachment", @onchange = "return filechange();", @accept = "application/pdf" })<br />
                                            <span style="color:red;font-family:Cambria;font-weight:bolder;">केवल PDF फ़ाइल अपलोड करें!</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="vertical-without-time vertical-timeline--animate vertical-timeline--one-column">
                    <div class="vertical-timeline-item vertical-timeline-element">
                        <div>
                            <span class="vertical-timeline-element-icon bounce-in">
                                <i class="badge badge-dot badge-dot-xl badge-success"> </i>
                            </span>

                            <div class="vertical-timeline-element-content bounce-in">
                                <h3 class="timeline-title">संस्थित जाँच के समय अपचारी के कार्यालय का विवरण</h3>
                                <br />
                                <div class="form-row">
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">संस्थित जांच कार्यालय </label>
                                            <select class="form-control" id="PreviousComplaintRelatedTo" name="PreviousComplaintRelatedTo"></select>
                                        </div>
                                    </div>

                                    <div class="col-md-4 mb-3" id="Previouszoneddl">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">संस्थित जांच का ज़ोन </label>

                                            <select class="form-control" id="PreviousComplaintRelatedZoneId" name="PreviousComplaintRelatedZoneId"></select>
                                        </div>

                                    </div>

                                    <div class="col-md-4 mb-3" id="Previouscircleddl">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">संस्थित जांच का सर्किल </label>
                                            <select class="form-control" id="PreviousComplaintRelatedCircleId" name="PreviousComplaintRelatedCircleId"></select>

                                        </div>

                                    </div>
                                    <div class="col-md-4 mb-3" id="Previousddldivision">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">संस्थित जांच का डिवीज़न </label>
                                            <select class="form-control" id="PreviousComplaintRelatedDivisionId" name="PreviousComplaintRelatedDivisionId"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">संस्थित जांच का पदनाम</label><br />
                                            <select class="form-control" id="PreviousComplaintDesignationId" name="PreviousComplaintDesignationId"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">कार्य अवधि(कब से) </label><br />
                                            @Html.TextBoxFor(m => m.WorkDurationFrom, new { @class = "form-control", @data_toggle = "datepicker-month", @autocomplete = "off", @placeholder = "MM/DD/YYYY", @maxlength = "10", })
                                        </div>

                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">कार्य अवधि(कब तक) </label><br />
                                            @Html.TextBoxFor(m => m.WorkDurationTo, new { @class = "form-control", @data_toggle = "datepicker-month", @autocomplete = "off", @placeholder = "MM/DD/YYYY", @maxlength = "10", })
                                        </div>
                                    </div>

                                </div>
                                <div class="form-row">
                                    <div class="col-md-6 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="validationCustom05">चयन करें</label> <br />
                                            <input type="checkbox" name="IsFinancial" value="वित्तीय" onclick="onlyOne1(this)" />&emsp;वित्तीय &emsp;
                                            <input type="checkbox" name="IsFinancial" value="गैर वित्तीय" onclick="onlyOne1(this)" />&emsp;गैर वित्तीय
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="validationCustom05">राशि</label>
                                            @Html.TextBoxFor(m => m.FinancialAmount, new { @class = "form-control", @onkeypress = "if(isNaN(this.value + String.fromCharCode(event.keyCode) )) return false;" })
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">

                                        <div class="position-relative form-group">
                                            <label for="validationCustom05">निलंबन की स्तिथि  </label> <br />
                                            <input type="checkbox" name="IsSuspension" value="हाँ" onclick="onlyOne2(this)" />&emsp;हाँ &emsp;
                                            <input type="checkbox" name="IsSuspension" value="नहीं" onclick="onlyOne2(this)" />&emsp;नहीं
                                        </div>

                                    </div>
                                    <div class="col-md-6 mb-3" id="AssociatedOfficeDiv">
                                        <div class="position-relative form-group">
                                            <label for="validationCustom05">संबद्ध कार्यालय का नाम </label>
                                            <input type="text" class="form-control" id="AssociatedOfficeName" name="AssociatedOfficeName" />
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row" id="AssociatedOfficeSection">
                                    <div class="col-md-4 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">संबद्ध कार्यालय </label>
                                            <select class="form-control" id="AffiliatedOfficesRelatedTo" name="AffiliatedOfficesRelatedTo"></select>
                                        </div>
                                    </div>

                                    <div class="col-md-4 mb-3" id="AffiliatedOfficesZoneddl">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">संबद्ध ज़ोन</label>

                                            <select class="form-control" id="AffiliatedOfficesZoneId" name="AffiliatedOfficesZoneId"></select>
                                        </div>

                                    </div>

                                    <div class="col-md-4 mb-3" id="AffiliatedOfficesCircleddl">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">संबद्ध सर्किल</label>
                                            <select class="form-control" id="AffiliatedOfficesCircleId" name="AffiliatedOfficesCircleId"></select>

                                        </div>

                                    </div>
                                    <div class="col-md-4 mb-3" id="AffiliatedOfficesDivisionddl">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">संबद्ध डिवीज़न</label>
                                            <select class="form-control" id="AffiliatedOfficesDivisionId" name="AffiliatedOfficesDivisionId"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-3" id="AffiliatedOfficesDiv">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">संबद्ध कार्यालय का नाम</label><br />
                                            <select class="form-control" id="AffiliatedOfficesDesignationId" name="AffiliatedOfficesDesignationId"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="col-md-12 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">
                                                विवरण
                                            </label>

                                            @Html.TextAreaFor(m => m.ComplaintDescription, new { @class = "form-control", @onkeypress = "return /[a-z0-9,./ ]/i.test(event.key)", @style = "resize:none;", @rows = "5" })

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="vertical-without-time vertical-timeline--animate vertical-timeline--one-column">
                    <div class="vertical-timeline-item vertical-timeline-element">
                        <div>
                            <span class="vertical-timeline-element-icon bounce-in">
                                <i class="badge badge-dot badge-dot-xl badge-success"> </i>
                            </span>

                            <div class="vertical-timeline-element-content bounce-in">
                                <h3 class="timeline-title">जांच अधिकारी का विवरण</h3>
                                <br />
                                <div class="form-row ">
                                    <div class="col-md-3 mb-3">
                                        <div class="position-relative form-group">
                                            <label>जांच अधिकारी कहाँ से है</label>
                                            <select class="form-control" id="InvestigatingOfficerRelatedTo" name="InvestigatingOfficerRelatedTo"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-3" id="MarkedZonediv">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername"> ज़ोन </label>
                                            <select class="form-control" id="InvestigatingOfficerZoneId" name="InvestigatingOfficerZoneId"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-3" id="Markedcirclediv">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername"> सर्किल </label>
                                            <select class="form-control" id="InvestigatingOfficerCircleId" name="InvestigatingOfficerCircleId"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-3" id="Markeddivisiondiv">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername"> डिवीज़न </label>
                                            <select class="form-control" id="InvestigatingOfficerDivisionId" name="InvestigatingOfficerDivisionId"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-3" id="divComplaintSentToOfficer">
                                        <div class="position-relative form-group">
                                            <label for="validationCustomUsername">अधिकारी का पदनाम</label>
                                            <select class="dropdown form-control" id="InvestigatingOfficerDesignationId" name="InvestigatingOfficerDesignationId"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">अधिकारी का ईमेल आईडी</label>
                                            @Html.HiddenFor(m => m.InvestigatingOfficerUser_Number, new { @class = "form-control", @id = "InvestigatingOfficerUser_Number", @lang = "hi", @readonly = "true" })

                                            @Html.TextBoxFor(m => m.InvestigatingOfficerName, new { @class = "form-control", @id = "InvestigatingOfficerName", @lang = "hi", @readonly = "true" })
                                        </div>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <div class="position-relative form-group">
                                            <label for="exampleAddress" class="">अधिकारी का मोबाइल नंबर</label>
                                            @Html.TextBoxFor(m => m.InvestigatingOfficerMobile, new { @class = "form-control", @id = "InvestigatingOfficerMobile", @readonly = "true" })
                                        </div>
                                    </div>

                                </div>
                                <div class="text-left">
                                    <button class="btn-shadow btn-pill btn-wide btn btn-primary btnloader" id="btnSubmit">सेव करें</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
<script type="text/javascript">

    function onlyOne1(checkbox) {
        var checkboxes = document.getElementsByName('IsFinancial');
        var atLeastOneChecked = false;

        checkboxes.forEach((item) => {
            if (item !== checkbox) {
                item.checked = false;
            }
            if (item.checked) {
                atLeastOneChecked = true;
            }
        });
        if (!atLeastOneChecked && !checkbox.checked) {
            checkbox.checked = true;
        }
    }
    function onlyOne2(checkbox) {
        var checkboxes = document.getElementsByName('IsSuspension');
        var atLeastOneChecked = false;

        checkboxes.forEach((item) => {
            if (item !== checkbox) {
                item.checked = false;
            }
            if (item.checked) {
                atLeastOneChecked = true;
            }
        });
        if (!atLeastOneChecked && !checkbox.checked) {
            checkbox.checked = true;
        }
    }
    $(function () {
        $("input[type='checkbox'][name='IsFinancial']").change(function () {
            var IsFinancial = $(this).val();
            if (IsFinancial == "वित्तीय") {
                $("#FinancialAmount").val('');
                $("#FinancialAmount").prop("disabled", false);
            } else {
                $("#FinancialAmount").val('0');
                $("#FinancialAmount").prop("disabled", true);
            }

        });
        $("input[type='checkbox'][name='IsSuspension']").change(function () {
            var IsSuspension = $(this).val();
            if (IsSuspension == "हाँ") {
                $("#AssociatedOfficeSection").show();
                $("#AssociatedOfficeDiv").hide();
                $("#AssociatedOfficeName").val('');
                $("#AssociatedOfficeName").prop("disabled", false);
            } else {
                $("#AssociatedOfficeName").val('NA');
                $("#AssociatedOfficeName").prop("disabled", true);
                $("#AssociatedOfficeSection").hide();
                $("#AssociatedOfficeDiv").show();
                $("#AffiliatedOfficesRelatedTo").val('-1').trigger('change');
                $("#AffiliatedOfficesZoneId").val('-1').trigger('change');
                $("#AffiliatedOfficesCircleId").val('-1').trigger('change');
                $("#AffiliatedOfficesDivisionId").val('-1').trigger('change');
                $('#AffiliatedOfficesZoneddl,#AffiliatedOfficesCircleddl,#AffiliatedOfficesDivisionddl').hide();
            }
        });
    });
    $(document).ready(function () {
        $("#AssociatedOfficeSection").hide();
        $("#AffiliatedOfficesDiv").hide();$('#zoneddl,#circleddl,#ddldivision,#Previouszoneddl,#Previouscircleddl,#Previousddldivision,#MarkedZonediv,#Markedcirclediv,#Markeddivisiondiv,#AffiliatedOfficesZoneddl,#AffiliatedOfficesCircleddl,#AffiliatedOfficesDivisionddl').hide();
        BindComplaintRelatedTo('ComplaintRelatedTo,PreviousComplaintRelatedTo,InvestigatingOfficerRelatedTo,AffiliatedOfficesRelatedTo', -1);
        BindComplaintDesignation('ComplainRelatedDesignationId,PreviousComplaintDesignationId', -1);
        var msg = '@TempData["msg"]';
        if (msg == "inserted") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.success('डेटा सफलतापूर्वक सेव हो गया!');
        }
        else if (msg == "error") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.error('एरर!');
        }
        else if (msg == "uploadeeror") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.error('फ़ाइल अपलोड करते समय एरर!');
        }
        bindZone('ComplaintRelatedZoneId', -1);
        bindCircle('ComplaintRelatedCircleId', -1, -1);
        bindDivision('ComplaintRelatedDivisionId', -1, -1, -1);
    });

    $("#ComplaintRelatedTo").change(function () {
        var mrk = $(this).val().trim();
        if (mrk == "HQ") {
