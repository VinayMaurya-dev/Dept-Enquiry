        var MobileNo = $("#MobileNo").val();
        if (MobileNo == "") {
            showErrorNotification("कार्मिक का मोबाइल नंबर , भरे");
            $("#MobileNo").focus();
            return false;
        }
        var mobilePattern = /^[0-9]{10}$/;
        if (!mobilePattern.test(MobileNo)) {
            showErrorNotification("कृपया 10 अंकों का सही मोबाइल नंबर दर्ज करें");
