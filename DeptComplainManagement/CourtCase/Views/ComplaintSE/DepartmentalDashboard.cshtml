                                            </div>
                                        </div>

                                    </div>



                                    <div class="col-md-4">

                                        <div class="card mb-3 widget-chart widget-chart2 bg-focus text-left" style="background: linear-gradient(45deg, #8e00efeb, #26031a) !important;">
                                            <div class="widget-chart-content text-white">
                                                <div class="widget-chart-flex">
