@using CourtCase.Filters
@{
    ViewBag.Title = "ComplaintRemarkList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
<div class="app-main__inner">
    <div class="app-page-title app-page-title-simple">
        <div class="page-title-wrapper">
            <div class="page-title-heading">
                <div>
                    <div class="page-title-head center-elem">
                        <span class="d-inline-block pr-2">
                            <i class="lnr-apartment opacity-6"></i>
                        </span>
                        <span class="d-inline-block"> Complaint Remark List</span>
                    </div>
                    <div class="page-title-subheading opacity-10">
                        <nav class="" aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/ComplaintSE/Index">
                                        <i aria-hidden="true" class="fa fa-home"></i>
                                    </a>
                                </li>

                                <li class="active breadcrumb-item" aria-current="page">
                                    Complaint Remark List
                                </li>
                            </ol>
                        </nav>

                    </div>

                </div>
            </div>

        </div>
    </div>
    <center>

        <div class="main-card mb-3 card">
            <div class="card-body">
                <div id="step-1">
                    <div class="form-row">
                        <div class="col-md-3">
                            <div class="position-relative form-group">
                                <label for="exampleEmail55">From Date</label>
                                <input type="date" class="form-control" id="FromDate" name="FromDate" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="position-relative form-group">
                                <label for="examplePassword22">To Date</label>
                                <input type="date" class="form-control" id="ToDate" name="ToDate" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="position-relative form-group">
                                <label for="examplePassword22">Remark By Designation</label>
                                <select class="dropdown form-control CaseRelatedTo" id="RemarkByDesignation" name="RemarkByDesignation">
                                    <option value="">Choose option</option>
                                    <option value="Z">Zone</option>
                                    <option value="C">Circle</option>
                                    <option value="D">Division</option>
                                    <option value="H">HQ</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="position-relative form-group">
                                <button class="mb-2 mr-2 btn btn-primary" style="margin-top: 32px;
    margin-left: 44px;" id="searchButton">
                                    Search
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body">



                <div id="step-1">

                    <div class="form-row" id="divDetails">

                        <div class="table-responsive" style="margin-top:15px;">


                            @if (Model != null)
                            {
                                System.Data.DataSet ds = ((System.Data.DataSet)Model);
                                System.Data.DataTable dt = new System.Data.DataTable();

                                if (ds.Tables.Count > 0 && ds != null)
                                {
                                    dt = ds.Tables[0];
                                }
                                <table id="scr-vtr-dynamic" class="example table table-hover table-striped table-bordered mb-0" style="width:100%;">
                                    <thead>
                                        <tr>
                                            @foreach (System.Data.DataColumn col in dt.Columns)
                                            {

                                                <th>@Html.Raw(col.ColumnName)</th>
                                            }
                                        </tr>

                                    </thead>

                                    <tbody>
                                        @foreach (System.Data.DataRow row in dt.Rows)
                                        {

                                            <tr id="lblRowColor">

                                                @foreach (System.Data.DataColumn column in dt.Columns)
                                                {
                                                    var cellValue = row[column].ToString();
                                                    if (column.ColumnName == "Action")
                                                    {
                                                        <td>
                                                            @Html.EncodedActionLink(
                                                                "देखें",
                                                                "ViewComplaintList",
                                                                "ComplaintSE",
                                                                new { ComplaintNo = cellValue },
                                                                new { @class = "btn-transition btn btn-outline-info" },
                                                                "fa fa-eye"
                                                            )
                                                        </td>
                                                    }

                                                    else
                                                    {
                                                        <td>@Html.Raw(cellValue)</td>
                                                    }
                                                }

                                            </tr>


                                        }

                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </center>
</div>
<script>
    $(document).ready(function () {
        var msg = '@TempData["msg"]';
        $('#ReceivedComplaint').addClass("mm-active");
        $('#SEDashboard').removeClass("mm-active");
    });
</script>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script>
    $(document).ready(function () {
        $('#searchButton').click(function () {
            var formData = {
                FromDate: $('#FromDate').val(),
                ToDate: $('#ToDate').val(),
                RemarkByDesignation: $('#RemarkByDesignation').val()
            };

            $.ajax({
                type: 'POST',
                url: '@Url.Action("ComplaintRemarkList", "ComplaintSE")',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (data) {
                    var table = $('#scr-vtr-dynamic');

                    if (data.length > 0) {
                        var htmlNew = data;
                        $("#divDetails").html($(htmlNew).find("#divDetails"));
                        new DataTable('.example', {
                            layout: {
                                topStart: {
                                    buttons: [
                                        'print',
                                        {
                                            extend: 'excel',
                                            exportOptions: {
                                                columns: ':visible'
                                            }
                                        },
                                        'colvis'
                                    ]
                                }
                            }
                        });
                    } else {
                        table.html('<thead><tr><th colspan="100%">No Record Found</th></tr></thead>');
                    }
                },
                error: function (xhr, status, error) {
                    console.error(xhr.responseText);
                    alert('Error: ' + error);
                }
            });
        });
    });
</script>

