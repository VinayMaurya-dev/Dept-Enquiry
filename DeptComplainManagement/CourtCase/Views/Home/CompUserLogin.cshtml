@model  CourtCase.Models.UserLogin
@{
    Layout = null;
    var msg = TempData["Msg"] ?? string.Empty;
}

<style>
    #chartdiv, #chartBardiv {
        width: 100%;
        height: 422px;
    }

    g[aria-labelledby="id-66-title"] {
        display: none;
    }

    g[aria-labelledby="id-154-title"] {
        display: none;
    }
</style>

<!-- Resources -->
<script src="~/HomeChartJS/core.js"></script>
<script src="~/HomeChartJS/charts.js"></script>
<script src="~/HomeChartJS/animated.js"></script> 
<!-- Chart code -->
@{
    // Pass ViewBag values to JavaScript variables
    var totalEnquiry = ViewBag.TotalEnquiry;
    var pendingEnquiry = ViewBag.PendingEnquiry;
    var closedEnquiry = ViewBag.ClosedEnquiry;
    var Level1 = ViewBag.Level1;
    var Level2 = ViewBag.Level2;
    var Level3 = ViewBag.Level3;
    var Level4 = ViewBag.Level4;
}


<script>

    am4core.ready(function () {
        am4core.useTheme(am4themes_animated);

        // Create chart instance
        var chart = am4core.create("chartdiv", am4charts.PieChart);
        //chart._logo.dispose()
        // Add and configure Series
        var pieSeries = chart.series.push(new am4charts.PieSeries());
        pieSeries.dataFields.value = "litres";
        pieSeries.dataFields.category = "country";
        chart.innerRadius = am4core.percent(30);
        pieSeries.slices.template.stroke = am4core.color("#fff");
        pieSeries.slices.template.strokeWidth = 2;
        pieSeries.slices.template.strokeOpacity = 1;
        pieSeries.slices.template.cursorOverStyle = [
            {
                "property": "cursor",
                "value": "pointer"
            }
        ];

        pieSeries.alignLabels = false;
        pieSeries.labels.template.bent = true;
        pieSeries.labels.template.radius = 3;
        pieSeries.labels.template.padding(0, 0, 0, 0);
        pieSeries.ticks.template.disabled = true;

        var shadow = pieSeries.slices.template.filters.push(new am4core.DropShadowFilter);
        shadow.opacity = 0;

        var hoverState = pieSeries.slices.template.states.getKey("hover");
        var hoverShadow = hoverState.filters.push(new am4core.DropShadowFilter);
        hoverShadow.opacity = 0.7;
        hoverShadow.blur = 5;

        // Add a legend
        chart.legend = new am4charts.Legend();

        // Bind ViewBag data to the chart
          chart.data = [
            //  { "country": "Total Enquiry", "litres": @totalEnquiry, "color": am4core.color("#203f77") },
              { "country": "Pending Enquiry", "litres": @pendingEnquiry, "color": am4core.color("#d99605") },
              { "country": "Closed Enquiry", "litres": @closedEnquiry, "color": am4core.color("#149e62") }
        ];

        // Apply slice colors
        pieSeries.slices.template.propertyFields.fill = "color";
    });
</script>
<script>
    am4core.ready(function () { 
        // Themes begin
        am4core.useTheme(am4themes_animated);
        // Themes end

        // Create chart instance
        var chart = am4core.create("chartBardiv", am4charts.XYChart);

        // Add data
        chart.data = [
            { "country": "Level-1", "litres": @Level1, "color": am4core.color("#203f77") },
            { "country": "Level-2", "litres": @Level2, "color": am4core.color("#d99605") },
            { "country": "Level-3", "litres": @Level3, "color": am4core.color("#149e62") },
            { "country": "Level-4", "litres": @Level4, "color": am4core.color("#af3cb8") }
        ];

        // Create axes
        var categoryAxis = chart.xAxes.push(new am4charts.CategoryAxis());
        categoryAxis.dataFields.category = "country";
        categoryAxis.renderer.grid.template.location = 0;
        categoryAxis.renderer.minGridDistance = 30;

        categoryAxis.renderer.labels.template.adapter.add("dy", function (dy, target) {
            if (target.dataItem && target.dataItem.index % 2 === 1) {
                return dy + 25;
            }
            return dy;
        });

        var valueAxis = chart.yAxes.push(new am4charts.ValueAxis());
        valueAxis.title.text = "Total Pending Enquiry"; 

        // Create series
        var series = chart.series.push(new am4charts.ColumnSeries());
        series.dataFields.valueY = "litres";
        series.dataFields.categoryX = "country";
        series.name = "Litres";
        series.columns.template.tooltipText = "{categoryX}: [bold]{valueY}[/]";
        series.columns.template.fillOpacity = 0.8;

        // Apply colors from data
        series.columns.template.propertyFields.fill = "color";
        series.columns.template.propertyFields.stroke = "color";

        var columnTemplate = series.columns.template;
        columnTemplate.strokeWidth = 2;
        columnTemplate.strokeOpacity = 1;

    }); // end am4core.ready()
</script>



