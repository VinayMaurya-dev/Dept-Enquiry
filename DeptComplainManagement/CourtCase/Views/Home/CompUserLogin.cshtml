        </div>
    </header>
    <div class="login-15">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-4">
                    <div class="login-inner-form">
                        <div class="details" style="min-height: 400px !important;">
                            <div class="card-title text-center h6">Enquiry Status</div>
                            <div id="chartdiv"></div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="login-inner-form">
                        <div class="details"> 
                            <h4 style="margin-bottom: 15px">Log In to your account</h4>
                            @Html.AntiForgeryToken()

                            @if (!string.IsNullOrEmpty(Convert.ToString(ViewData["ErrorMsg"])))
                            {
                                if (ViewData["ErrorMsg"].ToString() == "Success")
                                {
                                    <div class="alert alert-success" id="errorMsg">
                                        Successfully Login !
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger" id="errorMsg">
                                        @ViewData["ErrorMsg"]
                                    </div>
                                }
                            }

                            <!-- Password Login Form -->
                            @Html.Partial("Partial/_UserIDPassword")
                            <!-- Password Mobile Form -->
                            @Html.Partial("Partial/_MobileInputPartial")
                            <!-- Include the OTP Input Partial -->
                            @Html.Partial("Partial/_OtpInputPartial")

                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="login-inner-form">
                        <div class="details">
                            <div class="card-title text-center h6">Level Wise Pending Enquiry</div>
                            <div id="chartBardiv"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <footer style="background:#693fb2; color:#ffffff;height:50px; line-height:50px;text-align:center;">
        <div class="container-fluid">
            <p>
                Powered By :<a href="http://thinkcomputers.co.in/" target="_blank" style="color:white;">Think Computers</a> © @DateTime.Now.Year All Right Reserved
            </p>
        </div>
    </footer>
    <!--notification js -->
    <script src="~/assets/css/lobibox.min.js"></script>
    <script src="~/assets/css/notifications.min.js"></script>
    <script src="~/assets/css/notification-custom-script.js"></script>
