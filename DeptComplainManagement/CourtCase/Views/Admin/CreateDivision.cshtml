@model CourtCase.Models.Division
@{
    ViewBag.Title = "CreateDivision";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<div class="app-main__inner">
    <div class="app-page-title app-page-title-simple">
        <div class="page-title-wrapper">
            <div class="page-title-heading">
                <div>
                    <div class="page-title-head center-elem">
                        <span class="d-inline-block pr-2">
                            <i class="lnr-apartment opacity-6"></i>
                        </span>
                        <span class="d-inline-block">  Create Division </span>
                    </div>
                    <div class="page-title-subheading opacity-10">
                        <nav class="" aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <button type="button" onclick="history.back()" value="BACK" class="btn btn-primary mybackbutton"><i class="fa fa-arrow-left" aria-hidden="true"> Back</i></button>
                                </li>

                                <li class="active breadcrumb-item" aria-current="page">
                                    Create Division 
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>

        </div>
    </div>

    
    <div class="tab-content">

        <div class="main-card mb-3 card">
            <div class="card-body">
                @*<h5 class="card-title">Add Division</h5><br />*@
                <input type="hidden" value="@Model.DivisionId" id="hiddenDivisionId" />

                <div class="form-row" id="caseTypeDiv">
                    <div class="col-md-12">
                        <div class="form-row">
                            <div class="col-md-4 mb-3">
                                <label for="validationCustomUsername">Zone Name</label>
                                <div class="input-group">
                                    @*@Html.DropDownListFor(model => model.ZoneId, ViewBag.ZoneName as SelectList,"Select Zone",
                                        new { @class = "form-control zone",@id="txtZoneId"})*@

                                    <select class="form-control" id="ZoneId" name="ZoneId"></select>



                                </div>
                                <span id="ZoneIdError"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="exampleAddress" class="">Circle Name</label>
                                <div class="input-group">
                                    @*@Html.DropDownListFor(model => model.CircleId, ViewBag.CircleName as SelectList,"Select Circle",
                                        new { @class = "form-control circle",@id= "txtCircleId" })*@

                                    <select class="form-control" id="CircleId" name="CircleId"></select>



                                </div>
                                <span id="CircleIdError"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label for="exampleAddress" class="">Division Name</label>
                                <div class="input-group">
                                    <input type="text" value="@Model.DivisionName" id="txtDivisionName" class="form-control" placeholder="Enter Division" />



                                </div>
                                <span id="DivisionNameError"></span>
                                <div class="col-md-4 col-sm-4">

                                    <div class="row text-center" style="margin-top:22px; margin-left:-300px">
                                        <input type="submit" id="btnSubmit" value="@ViewBag.BtnName" class="btn-pill btn-shadow btn-success btn" onclick="return SaveUpdateDivisionRecord()">

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-xs-12 col-md-12 col-lg-12">
            <div class="card order-card" style="margin:-18px;padding:10px;">
                @*<input type="hidden" value="@Model.ZoneId" id="hiddenZoneId" />*@
                <div class="card-block">
                    <table class="table table-bordered" style="margin-top:0px !important;text-align:center;" id="caseTypeDiv">
                        <tr>
                            <th>
                                Sr No
                            </th>  
                            <th>Zone Name</th>
                            <th>Circle Name</th>
                            <th>
                                Division Name
                            </th>
                            <th>
                                Action
                            </th>



                        </tr>

                        @if (Model.Table != null)

                        {
                            int i = 0;
                            foreach (System.Data.DataRow data in Model.Table.Rows)
                            {
                                i++;
                                <tr>
                                    <td>
                                        @i
                                    </td> 

                                    <td>@data["ZoneName"]</td>
                                    <td>@data["CircleName"]</td>
                                    <td>
                                        @data["DivisionName"]
                                    </td>
                                    <td>

                                        <a href="/Admin/CreateDivision?DivisionId=@data["DivisionId"]" class="btn-pill btn-shadow btn-primary btn">Edit</a>

                                    </td>


                                </tr>

                            }
                        }

                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {

        $('#ReportLI').addClass("mm-active");
        $('#ReportUL').addClass("mm-show");
        $('#DivisionMaster').addClass("mm-active");
        $('#AdminDashboard').removeClass("mm-active");

          var val1 = ('@TempData["ZoneId"]');
            bindZone('ZoneId', val1);
      

         var val2 = ('@TempData["CircleId"]');
        bindCircle('CircleId', val2, val1);

        $("#ZoneId").change(function () {

            bindCircle('CircleId', -1, $("#ZoneId").val());
        });

    });

       

    function bindZone(id, defaultSelectionValues) {
        defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
        if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
            defaultSelectionValues = '-1';
        }
        var obj = new Object();
        obj.Action = "bindZone";

        $.ajax({
            type: 'POST',
            url: '/DropdownBinder/fillDropdown',
            data: { Action: obj.Action },
            success: function (Data) {
                var ddl = $('#' + id);
                ddl.empty();
                ddl.append($('<option/>', {
                    value: "-1",
                    text: "Choose option "
                }));

                $.each(Data, function (index, rowData) {
                    ddl.append($('<option/>', {
                        value: rowData.id,
                        text: rowData.value
                    }));
                });
                ddl.val(defaultSelectionValues);
            },
            error: function (errorData) {
                console.log(errorData);
            }
        });

    }



    function bindCircle(id, defaultSelectionValues, ZoneId) {
        defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
        if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
            defaultSelectionValues = '-1';
        }
        var obj = new Object();
        obj.Action = "bindCircle";
        obj.ZoneId = ZoneId;

        $.ajax({
            type: 'POST',
            url: '/DropdownBinder/fillDropdown',
            data: { Action: obj.Action, ZoneId: obj.ZoneId },
            success: function (Data) {
                var ddl = $('#' + id);
                ddl.empty();
                ddl.append($('<option/>', {
                    value: "-1",
                    text: "Choose option "
                }));

                $.each(Data, function (index, rowData) {
                    ddl.append($('<option/>', {
                        value: rowData.id,
                        text: rowData.value
                    }));
                });
                ddl.val(defaultSelectionValues);
            },
            error: function (errorData) {
                console.log(errorData);
            }
        });

    }
    function Validate() {
        var ZoneId = document.getElementById("ZoneId").selectedIndex;
        if (ZoneId == 0) {
            $("#ZoneIdError").text("Please Select The Zone Name");
            $("#ZoneIdError").css("color", "red");
            $("#ZoneId").focus();
            return false;
        }
        else {
            $("#ZoneIdError").text("");
        }
        var CircleId = document.getElementById("CircleId").selectedIndex;
        if (CircleId == 0) {
            $("#CircleIdError").text("Please Select The Circle Name");
            $("#CircleIdError").css("color", "red");
            $("#CircleId").focus();
            return false;
        }
        else {
            $("#CircleIdError").text("");
        }
            var DivisionName = $("#txtDivisionName").val();
            if (DivisionName == "") {
                $("#DivisionNameError").text("Please Enter The Division Name");
                $("#DivisionNameError").css("color", "red");
                $("#txtDivisionName").focus();
                return false;
            }
            else {
                $("#DivisionNameError").text("");
            }
           
           


            return true;
        }

        function SaveUpdateDivisionRecord() {
            debugger;

            if (!Validate()) {
                
                return false;
            }
            var obj = {

                DivisionId: $("#hiddenDivisionId").val(),

                DivisionName: $("#txtDivisionName").val(),
                ZoneId: $("#ZoneId").val(),
                CircleId: $("#CircleId").val(),

            }
            $.post("/Admin/SaveUpdateDivisionRecord", obj, function (Res) {
                if (Res != "") {
                    alert(Res);
                    window.location.href = "/Admin/CreateDivision";
                }
                else {
                    alert("Something Went wrong.");
                    window.location.href = "/Admin/CreateDivision";
                    window.location.href = "/Admin/CreateDivision";
                }
            });
        }

</script>


