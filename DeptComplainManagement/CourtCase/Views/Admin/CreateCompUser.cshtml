@model  CourtCase.Models.UserLogin
@{
    ViewBag.Title = "CreateCompUser";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var msg = TempData["Msg"] ?? string.Empty;
}
<style>
    .multiselect {
        width: 200px;
    }

    .selectBox {
        position: relative;
    }

    .overSelect {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
    }

    #checkboxes {
        display: none;
        border: 1px #dadada solid;
    }

        #checkboxes label {
            display: block;
        }

            #checkboxes label:hover {
                background-color: #1e90ff;
            }
</style>
<link href="~/assets/scripts/toastr.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.js"></script>
<script src="~/assets/scripts/toastr.js"></script>
@if (!string.IsNullOrEmpty(Convert.ToString(TempData["Msg"])))
{
    <script>
        var msg = '@msg';
        $('#MobileNo').val("");
        $('#EmailId').val("");
        $('#Password').val("");
        if (msg != "Error") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-center"
            }
            toastr.success(msg);

        }
        else {

            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-center"
            }
            toastr.error('Something Went Wrong !');
        }
       // alert(msg);
        //location.reload();

    </script>
}


<div class="app-main__inner">
    <div class="app-page-title app-page-title-simple">
        <div class="page-title-wrapper">
            <div class="page-title-heading">
                <div>
                    <div class="page-title-head center-elem">
                        <span class="d-inline-block pr-2">
                            <i class="lnr-apartment opacity-6"></i>
                        </span>
                        <span class="d-inline-block">
                            Create User Login
                        </span>
                    </div>
                    <div class="page-title-subheading opacity-10">
                        <nav class="" aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <button type="button" onclick="history.back()" value="BACK" class="btn btn-primary mybackbutton"><i class="fa fa-arrow-left" aria-hidden="true"> Back</i></button>
                                </li>

                                <li class="active breadcrumb-item" aria-current="page">
                                    Create User Login
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>

        </div>
    </div> 
    <div class="tab-content">
        <div class="tab-pane tabs-animation fade show active" id="tab-content-0" role="tabpanel">
            <div class="main-card mb-3 card">
                <div class="card-body">
                    @*<h5 class="card-title">Create User Login</h5>*@
                    @using (Html.BeginForm("CreateCompUser", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @onsubmit = "return Validate()" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-row">
                            <div class="col-md-4 mb-3">
                                <div class="position-relative form-group">
                                    <label>Role Type </label>
                                    <div class="multiselect">
                                        <div class="selectBox" onclick="showCheckboxes()">
                                            <select class="form-select form-select-sm" id="RoleId"></select>
                                            <input type="hidden" id="SelectedRoleType" value="" name="SelectedRoleType"/>
                                            <select class="overSelect   form-select form-select-sm  "></select>
                                        </div>
                                        <div id="checkboxes">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3" id="UserRelatedToDiv">
                                <div class="position-relative form-group">
                                    <label>User Related To</label>
                                    <select class="form-control" id="UserRelatedTo" name="UserRelatedTo"></select>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3" id="ZoneDiv">
                                <div class="position-relative form-group">
                                    <label>Zone</label>
                                    <select class="form-control" id="ZoneId" name="ZoneId"></select>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3" id="CircleDiv">
                                <div class="position-relative form-group">
                                    <label>Circle</label>
                                    <select class="form-control" id="CircleId" name="CircleId"></select>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3" id="DivisionDiv">
                                <div class="position-relative form-group">
                                    <label>Division</label>
                                    <select class="form-control" id="DivisionId" name="DivisionId"></select>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3" id="DesignationDiv">
                                <div class="position-relative form-group">
                                    <label>Designation</label>
                                    <select class="form-control" id="DesignationId" name="DesignationId"></select>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="position-relative form-group">
                                    <label>
                                        Mobile No

                                    </label>
                                    @Html.TextBoxFor(m => m.MobileNo, new { @class = "form-control", @onkeypress = "return /[0-9]/i.test(event.key)", @placeholder = "Mobile No." ,@maxlength="10" })

                                </div>
                            </div>
                            <div class="col-md-4 mb-3 d-none">
                                <div class="position-relative form-group">
                                    <label>
                                        Name
                                    </label>
                                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @placeholder = "Name.." })

                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="position-relative form-group">
                                    <label>
                                        Email Id
                                    </label>
                                    @Html.TextBoxFor(m => m.EmailId, new { @class = "form-control", @placeholder = "Email Id.." })

                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="position-relative form-group">
                                    <label>
                                        Password<bold>
                                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger", @style = "color:red;" })
                                        </bold>
                                    </label>
                                    @Html.TextBoxFor(m => m.Password, new { @class = "form-control", @placeholder = "Password.." })

                                </div>
                            </div>
                        </div>


                        <button class="mt-2 btn btn-primary">Save</button>
                    }
                </div>
            </div>

        </div>

    </div>
</div>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
<script>
    BindUserRelatedTo('UserRelatedTo', -1);
    $(document).ready(function () {
        $('#DivisionDiv').hide();
        $('#CircleDiv').hide();
        $('#ZoneDiv').hide();
        bindZone('ZoneId', -1);
        bindCircle('CircleId', -1);
        bindDivision('DivisionId', -1);
        BindRoleType('RoleId', -1)
        $('#UserRelatedTo').change(function () {
            var UserRelatedTo = $('#UserRelatedTo').val().trim();
            BindDesignation("DesignationId", -1);
            if (UserRelatedTo == "Z") {
                $('#ZoneDiv').show();
                $('#CircleDiv').hide();
                $('#DivisionDiv').hide(); 
                $("#CircleId").val('-1');
                $("#DivisionId").val('-1'); 
            }
            else if (UserRelatedTo == "C") {
                $('#ZoneDiv').show();
                $('#CircleDiv').show();
                $('#DivisionDiv').hide();  
                $("#DivisionId").val('-1');  
            }
            else if (UserRelatedTo == "D") {
                $('#ZoneDiv').show();
                $('#CircleDiv').show();
                $('#DivisionDiv').show(); 
            }
            else {
                $('#DivisionDiv').hide();
                $('#CircleDiv').hide();
                $('#ZoneDiv').hide();
                $("#ZoneId").val('-1');
                $("#CircleId").val('-1');
                $("#DivisionId").val('-1'); 
            }

        })
        $('#ZoneId').change(function () {
            var ZoneId = $('#ZoneId').val();
            bindCircle('CircleId', ZoneId);
        })
        $('#CircleId').change(function () {
            var ZoneId = $('#ZoneId').val();
            var CircleId = $('#CircleId').val();
            bindDivision('DivisionId', ZoneId, CircleId);

        })
    });
    function BindUserRelatedTo(id, defaultSelectionValues) {

        defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
        if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
            defaultSelectionValues = '-1';
        }
        var obj = new Object();
        obj.Action = "bindUserRoleType";
        $.ajax({
            type: 'POST',
            url: '/DropdownBinder/fillDropdown',
            data: { Action: obj.Action },
            success: function (Data) {
                var ddl = $('#' + id);
                ddl.empty();
                ddl.append($('<option/>', {
                    value: "-1",
                    text: "Choose option "
                }));

                $.each(Data, function (index, rowData) {
                    ddl.append($('<option/>', {
                        value: rowData.id,
                        text: rowData.value
                    }));
                });
                //  ddl.val(defaultSelectionValues);
            },
            error: function (errorData) {
                console.log(errorData);
            }

        });
        

    }
    function bindZone(id, defaultSelectionValues) {

        defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
        if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
            defaultSelectionValues = '-1';
        }
        var obj = new Object();
        obj.Action = "bindZone";

        $.ajax({
            type: 'POST',
            url: '/DropdownBinder/fillDropdown',
            data: { obj: obj },
            success: function (Data) {
                var ddl = $('#' + id);
                ddl.empty();
                ddl.append($('<option/>', {
                    value: "-1",
                    text: "Choose option "
                }));

                $.each(Data, function (index, rowData) {
                    ddl.append($('<option/>', {
                        value: rowData.id,
                        text: rowData.value
                    }));
                });
                //  ddl.val(defaultSelectionValues);
            },
            error: function (errorData) {
                console.log(errorData);
            }
        });

    }
    function bindDivision(id, defaultSelectionValues, CircleId) {

        defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
        if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
            defaultSelectionValues = '-1';
        }
        var obj = new Object();
        obj.Action = "bindDivision";
        obj.ZoneId = defaultSelectionValues;
        obj.CircleId = CircleId
        $.ajax({
            type: 'POST',
            url: '/DropdownBinder/fillDropdown',
            data: { obj: obj },
            success: function (Data) {
                var ddl = $('#' + id);
                ddl.empty();
                ddl.append($('<option/>', {
                    value: "-1",
                    text: "Choose option "
                }));

                $.each(Data, function (index, rowData) {
                    ddl.append($('<option/>', {
                        value: rowData.id,
                        text: rowData.value
                    }));
                });
                //  ddl.val(defaultSelectionValues);
            },
            error: function (errorData) {
                console.log(errorData);
            }
        });

    }
    function bindCircle(id, defaultSelectionValues) {

        defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
        if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
            defaultSelectionValues = '-1';
        }
        var obj = new Object();
        obj.Action = "bindCircle";
        obj.ZoneId = defaultSelectionValues;
        $.ajax({
            type: 'POST',
            url: '/DropdownBinder/fillDropdown',
            data: { obj: obj },
            success: function (Data) {
                var ddl = $('#' + id);
                ddl.empty();
                ddl.append($('<option/>', {
                    value: "-1",
                    text: "Choose option "
                }));

                $.each(Data, function (index, rowData) {
                    ddl.append($('<option/>', {
                        value: rowData.id,
                        text: rowData.value
                    }));
                });
                //ddl.val(defaultSelectionValues);
            },
            error: function (errorData) {
                console.log(errorData);
            }
        });

    }
    function BindDesignation(id, defaultSelectionValues) {

        defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
        if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
            defaultSelectionValues = '-1';
        }
        var obj = new Object(); 
        obj.Action = "bindDesignations";
        obj.CaseRelatedTo = $('#UserRelatedTo').val().trim();
        obj.RoleTypeId = $('#SelectedRoleType').val().trim();
        $.ajax({
            type: 'POST',
            url: '/DropdownBinder/fillDropdown',
            data: { obj: obj },
            success: function (Data) {
                var ddl = $('#' + id);
                ddl.empty();
                ddl.append($('<option/>', {
                    value: "-1",
                    text: "Choose option "
                }));

                $.each(Data, function (index, rowData) {
                    ddl.append($('<option/>', {
                        value: rowData.id,
                        text: rowData.value
                    }));
                });
                // ddl.append(defaultSelectionValues);
            },
            error: function (errorData) {
                console.log(errorData);
            }
        });

    }
    function BindRoleType(id, defaultSelectionValues) {
        defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '-1';

        if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
            defaultSelectionValues = '-1';
        }

        var obj = {
            Action: "bindCompUserTypeRoles"
        };

        $.ajax({
            type: 'POST',
            url: '/DropdownBinder/fillDropdown',
            data: { Action: obj.Action },
            success: function (Data) {
                // Bind dropdown
                var ddl = $('#' + id);
                ddl.empty();
                ddl.append($('<option/>', {
                    value: "-1",
                    text: "Choose option",
                    class: "form-control"
                }));


                // Bind checkboxes
                var checkboxesContainer = $("#checkboxes");
                checkboxesContainer.empty();

                $.each(Data, function (i, item) {
                    checkboxesContainer.append(
                        '<label for="checkbox_' + i + '">' +
                        '<input type="checkbox" id="checkbox_' + i + '" value="' + item.id + '" name="RoleType" /> ' +
                        item.value +
                        '</label>'
                    );
                });
            },
            error: function (errorData) {
                console.error("Error while binding role types:", errorData);
            }
        });
    }

</script>
<script>
    var expanded = false;
    function showCheckboxes() {
        var checkboxes = document.getElementById("checkboxes");
        if (!expanded) {
            checkboxes.style.display = "block";
            expanded = true;
        } else {
            checkboxes.style.display = "none";
            expanded = false;
        }
    }

    $(document).on('click', "input[type='checkbox'][name='RoleType']", function () { 
        var selected = []; 
        if ($(this).val() === "SE" && $(this).prop("checked")) {
            
            $("input[type='checkbox'][name='RoleType']").not(this).prop("disabled", true).prop("checked", false);
        } else if ($(this).val() === "SE" && !$(this).prop("checked")) {
            
            $("input[type='checkbox'][name='RoleType']").not(this).prop("disabled", false);
        } 
        $("input[type='checkbox'][name='RoleType']:checked").each(function () {
            selected.push($(this).val());
        }); 
        $("#SelectedRoleType").val(selected.join(","));

        // Reset the 'UserRelatedTo' field
        $("#UserRelatedTo").val('-1').trigger('change');
    });
</script>

<script>
    function showErrorNotification(msg) {
        toastr.options = {
            "closeButton": true,
            "timeout": 1000,
            "progressBar": true,
            "positionClass": "toast-top-right"
        }
        toastr.error(msg);
    }
    function Validate() {

        var SelectedRoleType = $("#SelectedRoleType").val().trim();
        if (SelectedRoleType == "") {
            showErrorNotification("Please Select Role Type ");
            $(".overSelect").focus();
            return false;
        }



        var UserRelatedTo = $("#UserRelatedTo").val().trim();
        if (UserRelatedTo == "-1") {
            showErrorNotification("Please Select User Related To");
            $("#UserRelatedTo").focus();
            return false;
        }

        if (UserRelatedTo == "Z") {
            var ZoneId = $("#ZoneId").val();
            if (ZoneId == "-1") {
                showErrorNotification("Please Select Zone");
                $("#ZoneId").focus();
                return false;
            }
        }
        if (UserRelatedTo == "C") {
            var ZoneId = $("#ZoneId").val();
            if (ZoneId == "-1") {
                showErrorNotification("Please Select Zone");
                $("#ZoneId").focus();
                return false;
            }
            var CircleId = $("#CircleId").val();
            if (CircleId == "-1") {
                showErrorNotification("Please Select Circle");
                $("#CircleId").focus();
                return false;
            }
        }
        if (UserRelatedTo == "D") {
            var ZoneId = $("#ZoneId").val();
            if (ZoneId == "-1") {
                showErrorNotification("Please Select Zone");
                $("#ZoneId").focus();
                return false;
            }
            var CircleId = $("#CircleId").val();
            if (CircleId == "-1") {
                showErrorNotification("Please Select Circle");
                $("#CircleId").focus();
                return false;
            }
            var DivisionId = $("#DivisionId").val();
            if (DivisionId == "-1") {
                showErrorNotification("Please Select Division");
                $("#DivisionId").focus();
                return false;
            }
        }

        var DesignationId = $("#DesignationId").val();
        if (DesignationId == "-1") {
            showErrorNotification("Please Select Designation");
            $("#DesignationId").focus();
            return false;
        }

        var MobileNo = $("#MobileNo").val();
        if (MobileNo == "") {
            showErrorNotification("Please Enter Mobile Number");
            $("#MobileNo").focus();
            return false;
        } 

        var EmailId = $("#EmailId").val();
        if (EmailId == "") {
            showErrorNotification("Please Enter Email ID");
            $("#EmailId").focus();
            return false;
        }

        var Password = $("#Password").val();
        if (Password == "") {
            showErrorNotification("Please Enter Password");
            $("#Password").focus();
            return false;
        }
    }

</script>
