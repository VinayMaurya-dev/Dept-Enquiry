@using CourtCase.Filters
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{

    System.Data.DataSet ds = ((System.Data.DataSet)Model);
    System.Data.DataTable dt0 = new System.Data.DataTable();
    if (ds.Tables.Count > 0)
    {
        dt0 = ds.Tables[0];
    }

}
<div class="app-main__inner">
    <div id="accordion2" class="accordion-wrapper mb-3">
        <div class="card">
            <div id="headingTwo" class="card-header">
                <button type="button" data-toggle="collapse" data-target="#collapseTwo"
                        aria-expanded="true" aria-controls="collapseTwo"
                        class="text-left m-0 p-0 btn btn-link btn-block">
                    <h5 class="m-0 p-0 card-title">पदेन जाँच हेतु प्राप्त विभागीय शिकायत<i class="float-right pe-7s-angle-down-circle fa-1x" style="color:black;"></i></h5>
                </button>
            </div>
            <div data-parent="#accordion2" id="collapseTwo" aria-labelledby="headingTwo"
                 class="collapse show">
                <div class="card-body">
                    <div class="media">

                        <div class="media-body">
                            <div class="mt-2">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="card mb-3 widget-chart widget-chart2 text-left" style="background: linear-gradient(45deg, #2403b3, #490a4a) !important;">

                                            <div class="widget-chart-content text-white">
                                                <div class="widget-chart-flex">
                                                    <div class="widget-title">Total Enquiry</div>
                                                </div>
                                                <div class="widget-chart-flex">
                                                    <div class="widget-numbers">
                                                        @Html.EncodedActionLink(
                                                dt0.Rows[0]["TotalDepComplain"].ToString
                                                (),
                                                 "ReceivedComplaints",
                                               "ComplaintInspection",
                                                  new { ComplaintType = "" },
                                                new { @class = "text-white" },
                                                "")

                                                    </div>
                                                    <div class="widget-description ml-auto opacity-7">
                                                        <i class="pe-7s-note2" style="font-size:xx-large;"></i>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                    <div class="col-md-4">
                                        <div class="card mb-3 widget-chart widget-chart2 bg-focus text-left" style="background: linear-gradient(116deg, #ed1903, #720f0f) !important">
                                            <div class="widget-chart-content text-white">
                                                <div class="widget-chart-flex">
                                                    <div class="widget-title">Closed Enquiry</div>

                                                </div>
                                                <div class="widget-chart-flex">
                                                    <div class="widget-numbers">
                                                        @Html.EncodedActionLink(
                                                 dt0.Rows[0]["TotalDepClosedComplain"].ToString
                                                 (),
                                                  "ClosedComplaints",
                                                "ComplaintInspection",
                                                 new { ComplaintType = "Close" },
                                                 new { @class = "text-white" },
                                                 "")
                                                    </div>
                                                    <div class="widget-description ml-auto text-white">
                                                        <i class="pe-7s-note2" style="font-size:xx-large;"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card mb-3 widget-chart widget-chart2 bg-focus text-left" style="background: linear-gradient(209deg, #f7e803, #f79201) !important">
                                            <div class="widget-chart-content text-white">
                                                <div class="widget-chart-flex">
                                                    <div class="widget-title">Pending Enquiry</div>

                                                </div>
                                                <div class="widget-chart-flex">
                                                    <div class="widget-numbers">
                                                        @Html.EncodedActionLink(
                                                 dt0.Rows[0]["TotalDepPendingComplain"].ToString
                                                 (),
                                                  "ReceivedComplaints",
                                                "ComplaintInspection",
                                                 new { ComplaintType = "Pending" },
                                                 new { @class = "text-white" },
                                                 "")
                                                    </div>
                                                    <div class="widget-description ml-auto text-white">
                                                        <i class="pe-7s-note2" style="font-size:xx-large;"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div> 
                            </div> 
                        </div>
                    </div>
                </div>

            </div>
        </div> 
    </div>
</div>
@Html.Action("Dashboard", "Reports")