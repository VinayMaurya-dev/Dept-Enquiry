<script type="text/javascript">  
    $(document).ready(function () {
        var msg = '@TempData["msg"]';
                // toast 
        $('.zoneddl').hide();
        $('.circleddl').hide();
        $('.divisionddl').hide();
        $('#remarkdiv').hide(); 
        $('#statementdiv').hide();
        $('#UpdateStatusdiv').hide();
        if (msg == "inserted") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.success('डेटा सफलतापूर्वक सेव हो गया!');
        }
        else if (msg == "error") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.error('एरर!');
        }
        else if (msg == "uploadeeror") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.error('फ़ाइल अपलोड करते समय एरर!');
        }
         
        $('#remarkbutton').click(function () {
            const myDiv = document.getElementById('remarkdiv'); 
            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
            } 
            $('#forwarddiv').hide(); 
            $('#UpdateStatusdiv').hide();
        }); 

        $('.updatestatusbtn').click(function () {
            var currentID = $(this).attr("id");
            const myDiv = document.getElementById('UpdateStatusdiv');

            // Reset visibility and dropdown defaults
            $('#remarkdiv').hide();
            $('#statementdiv').hide();
            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
                $("#ActionName").empty();
                if (currentID === 'representationbtn') {
                    $("#ActionName").append('<option value="अपचारी को प्रश्नगत जाँच में अभ्यावेदन प्रस्तुत करने हेतु निर्गत पत्र का विवरण">अपचारी को प्रश्नगत जाँच में अभ्यावेदन प्रस्तुत करने हेतु निर्गत पत्र का विवरण</option>');
                    $("#Flag").val('1');
                }
                else if (currentID === 'reminderbtn') {
                    $("#ActionName").append('<option value="जाँच अधिकारी द्वारा अपचारी को अभ्यावेदन प्रस्तुत्त करने हेतु निर्गत अनुस्मारक पत्रों का विवरण ">जाँच अधिकारी द्वारा अपचारी को अभ्यावेदन प्रस्तुत्त करने हेतु निर्गत अनुस्मारक पत्रों का विवरण</option>');
                    $("#Flag").val('2');
                }
                else if (currentID === 'representationreceiptbtn') {
                    $("#ActionName").append('<option value="अभ्यावेदन प्राप्ति का विवरण ">अभ्यावेदन प्राप्ति का विवरण </option>');
                    $("#Flag").val('3');
                }
                $("#ActionName").prop("readonly", true);

            } else {
                myDiv.style.display = 'none';
            }
        }); 
    }); 
    function ErrorMessagefun(msg, id) {
        toastr.options = {
            "closeButton": true,
            "timeout": 1000,
            "progressBar": true,
            "positionClass": "toast-top-right"
        };
        toastr.error(msg);
        $("#" + id).focus();
    }
   
    $(function () {
        $('#statementbutton').click(function () {
            const myDiv = document.getElementById('statementdiv');
            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
                $("input[type='checkbox'][name='statementcheck']").prop("checked", false).trigger('change');
            }
            $("#remarkdiv").hide();
            $('#UpdateStatusdiv').hide();
        }); 
    }); 

    function ValidateforStatement() {
        var OtherComplaintStatementDocument = $("#OtherComplaintStatementDocument").val();
        if (!OtherComplaintStatementDocument) {
            ErrorMessagefun("आख्या पत्र अपलोड करें!", "OtherComplaintStatementDocument");
            $("#OtherComplaintStatementDocument").focus();
            return false;
        }

        var DateofdispatchComplaint = $("#DateofdispatchComplaint").val();
        if (!DateofdispatchComplaint) {
            ErrorMessagefun("जांच आख्या प्रेषण की तिथि चुनें !", "DateofdispatchComplaint");
            $("#DateofdispatchComplaint").focus();
            return false;
        }

        //let aaropData = [];
        //let allFilled = true;
        //$("textarea[name='AaropRemark']").each(function () {
        //    const remark = $(this).val().trim();
        //    const aaropID = $(this).siblings("input[name='AaropID']").val();
        //    if (remark === "") {
