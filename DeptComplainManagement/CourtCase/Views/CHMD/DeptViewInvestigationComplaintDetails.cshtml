        //        AaropRemark: remark
        //    });
        //});

        //if (!allFilled) {
        //    alert("सभी आरोप टिप्पणी भरें");
        //    return false;
        //}
        //$("#aaropData").val(JSON.stringify(aaropData));

        var ComplaintstatementRemarkDescription = $("#ComplaintstatementRemarkDescription").val().trim();
        if (!ComplaintstatementRemarkDescription) {
            ErrorMessagefun("आख्या का विवरण भरें !", "ComplaintstatementRemarkDescription");
            $("#ComplaintstatementRemarkDescription").focus();
            return false;
        }
        const isConfirmed = confirm("क्या आप सुनिश्चित हैं कि आप विवरण जमा करना चाहते हैं? एक बार जमा करने के बाद, इन्हें बदला नहीं जा सकता।");
        if (!isConfirmed) {
            return false;
        }

    }

    function showErrorNotification(msg) {
        toastr.options = {
            "closeButton": true,
            "timeout": 1000,
            "progressBar": true,
            "positionClass": "toast-top-right"
        }
        toastr.error(msg);
    }

    function filechange2() {
        var fileInput = $("#OtherComplaintDocument1")[0];
        if (fileInput.files.length > 0) {
            var file = fileInput.files[0];
            var allowedFileTypes = ["application/pdf"];
            if (allowedFileTypes.indexOf(file.type) === -1) {
                showErrorNotification("कृपया केवल PDF फ़ाइल अपलोड करें!.");
                fileInput.value = ""; // Clear the file input
                return false;
            }
            var maxSizeInBytes = 5 * 1024 * 1024; // 5 MB limit (adjust as needed)
            if (file.size > maxSizeInBytes) {
                showErrorNotification("फ़ाइल का Size 5 MB की स्वीकृत सीमा से अधिक है। कृपया एक छोटी फ़ाइल चुनें.");
                fileInput.value = ""; // Clear the file input
                return false;
            }
        }
    }

