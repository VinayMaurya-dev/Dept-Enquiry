@using CourtCase.Filters
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{

    System.Data.DataSet ds = ((System.Data.DataSet)Model);
    System.Data.DataTable dt0 = new System.Data.DataTable();
    if (ds.Tables.Count > 0)
    {
        dt0 = ds.Tables[0];
    }

}
<style>
    .widget-title {
        font-size: large !important;
    }
</style>
@Html.Action("ChartDashboard", "Reports")
<div class="app-main__inner">
    <div id="accordion1Auth" class="accordion-wrapper mb-3">
        <div class="card">
            <div id="headingAuthOne1" class="card-header">
                <button type="button" data-toggle="collapse" data-target="#collapseAuthOne1"
                        aria-expanded="true" aria-controls="collapseOne"
                        class="text-left m-0 p-0 btn btn-link btn-block">
                    <h5 class="m-0 p-0 card-title">विभागीय जांच सूची<i class="float-right pe-7s-angle-down"></i></h5>
                </button>
            </div>
            <div data-parent="#accordion1Auth" id="collapseAuthOne1" aria-labelledby="headingAuthOne1"
                 class="collapse show">
                <div class="card-body">
                    <div class="media">

                        <div class="media-body">
                            <div class="mt-2">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="card mb-3 widget-chart widget-chart2 text-left" style="background: linear-gradient(300deg, #066036, #27c57b) !important;">

                                            <div class="widget-chart-content text-white">
                                                <div class="widget-chart-flex">
                                                    <div class="widget-title">Total Enquiry</div>
                                                </div>
                                                <div class="widget-chart-flex">
                                                    <div class="widget-numbers">
                                                        @Html.EncodedActionLink(
                                                         @dt0.Rows[0]["TotaldeptComplaint"].ToString
                                                          (),
                                                          "ComplaintList",
                                                          "ComplaintAuthorized",
                                                           new { ComplaintType = "" },
                                                          new { @class = "text-white" },
                                                          "")

                                                    </div>
                                                    <div class="widget-description ml-auto opacity-7">
                                                        <i class="pe-7s-note2" style="font-size:xx-large;"></i>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                    <div class="col-md-4">
                                        <div class="card mb-3 widget-chart widget-chart2 bg-focus text-left" style="background: linear-gradient(21deg, #80690d, #e8cd31) !important;">
                                            <div class="widget-chart-content text-white">
                                                <div class="widget-chart-flex">
                                                    <div class="widget-title">Pending Enquiry</div>

                                                </div>
                                                <div class="widget-chart-flex">
                                                    <div class="widget-numbers">
                                                        @Html.EncodedActionLink(
                                                          dt0.Rows[0]["PendingdeptComplaint"].ToString
                                                          (),
                                                          "ComplaintList",
                                                          "ComplaintAuthorized",
                                                          new { ComplaintType = "Pending" },
                                                          new { @class = "text-white" },
                                                          "")

                                                    </div>
                                                    <div class="widget-description ml-auto text-white">
                                                        <i class="pe-7s-note2" style="font-size:xx-large;"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card mb-3 widget-chart widget-chart2 bg-info text-left" style="background: linear-gradient(45deg, #0760a1, #00264c) !important;">

                                            <div class="widget-chart-content text-white">
                                                <div class="widget-chart-flex">
                                                    <div class="widget-title">Pending Revision</div>
                                                </div>
                                                <div class="widget-chart-flex">
                                                    <div class="widget-numbers">
                                                        @Html.EncodedActionLink(
                                                           dt0.Rows[0]["DeptRevisionComplaint"].ToString
                                                           (),
                                                           "RevisionEnquiryList",
                                                           "ComplaintAuthorized",
                                                           new { ComplaintType = "Revision" },
                                                           new { @class = "text-white" },
                                                           "")
                                                    </div>
                                                    <div class="widget-description ml-auto opcity-5">
                                                        <i class="pe-7s-note2" style="font-size:xx-large;"></i>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-md-4">
                                        <div class="card mb-3 widget-chart widget-chart2 bg-info text-left" style="background: linear-gradient(45deg, #8823e1, #440d4a) !important;">

                                            <div class="widget-chart-content text-white">
                                                <div class="widget-chart-flex">
                                                    <div class="widget-title">Pending Appeal</div>
                                                </div>
                                                <div class="widget-chart-flex">
                                                    <div class="widget-numbers">
                                                        @Html.EncodedActionLink(
                                                           dt0.Rows[0]["DeptAppealComplaint"].ToString
                                                           (),
                                                           "AppealEnquiryList",
                                                           "ComplaintAuthorized",
                                                           new { ComplaintType = "Appeal" },
                                                           new { @class = "text-white" },
                                                           "")
                                                    </div>
                                                    <div class="widget-description ml-auto opcity-5">
                                                        <i class="pe-7s-note2" style="font-size:xx-large;"></i>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-md-4">
                                        <div class="card mb-3 widget-chart widget-chart2 bg-info text-left" style="background: linear-gradient(233deg, #168f68, #0085af) !important;">

                                            <div class="widget-chart-content text-white">
                                                <div class="widget-chart-flex">
                                                    <div class="widget-title">Pending Show Cause</div>
                                                </div>
                                                <div class="widget-chart-flex">
                                                    <div class="widget-numbers">
                                                        @Html.EncodedActionLink(
                                                           dt0.Rows[0]["PendingShowCause"].ToString
                                                           (),
                                                           "PendingShowCauseNoticeList",
                                                           "ComplaintAuthorized",
                                                           new { status = "Pending" },
                                                           new { @class = "text-white" },
                                                           "")
                                                    </div>
                                                    <div class="widget-description ml-auto opcity-5">
                                                        <i class="pe-7s-note2" style="font-size:xx-large;"></i>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


@Html.Action("Dashboard", "Reports")