        <script type="text/javascript">
    $('#appealdiv,#Revisiondiv').hide();
    $("#forwarddiv").hide();
    $('#forwardingofficerDecisiondiv').hide();
    $('#forwardingofficerObjectiondiv').hide();
    $('#remarkbuttondiv').hide();
    $('#Hearingdiv').hide();
    bindDesignationsMarkedOfficerRevision('RevisionForwadingOfficerDesignations', -1, -1);
    bindDesignationsMarkedOfficerAppeal('AppealForwadingOfficerDesignations', -1, -1);
    $(document).ready(function () {
        var msg = '@TempData["msg"]';

        if (msg == "inserted") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.success('डेटा सफलतापूर्वक सेव हो गया!');
        }
        else if (msg == "error") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.error('एरर!');
        }
        else if (msg == "uploadeeror") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.error('फ़ाइल अपलोड करते समय एरर!');
        }


        $('#remarkbutton').click(function () {
            const myDiv = document.getElementById('remarkbuttondiv');
            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
