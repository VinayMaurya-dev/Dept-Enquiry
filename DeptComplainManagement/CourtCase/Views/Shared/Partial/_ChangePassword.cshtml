</div>
    <script>
        function showWarningNotification(msg) {
            Lobibox.notify('warning', {
                pauseDelayOnHover: true,
                size: 'mini',
                rounded: true,
                delayIndicator: false,
                icon: 'bx bx-error',
                continueDelayOnInactiveTab: false,
                position: 'top right',
                msg: msg
            });
        }
        $(document).ready(function () {
            $('#Old_Password').change(function () {
                OldPasswordvalidate();

            });
            $('#btnpassChange').click(function () {
                SaveChangePassword();
            });
            $('#password').change(function () {
                CureentPasswordvalidate();

            });
            $('#confirm_password').change(function () {
                ConfrmPasswordvalidate();

            });

        });
        function CheckOldPassword() {
            var OldPassword = $('#Old_Password').val();
            $.ajax({
                type: 'POST',
                url: '/Home/CheckPassword',
                data: { OldPassword: OldPassword },
                success: function (Data) {
                    if (Data !== "Error") {
                        $('#Old_Password').prop("disabled", true)
                    }
                    else {
                        $('#Old_Password').val('');
                        showWarningNotification("Your Password Does not Match");
                    }
                },
                error: function (errorData) {
                    showWarningNotification("Something Went  Wrong !");
                }
            });
        }
        function SaveChangePassword() {
            var OldPass = $('#Old_Password').val();
            var Pass = $('#password').val();
            var CnfrmPass = $('#confirm_password').val();
            if (OldPass === "") {
                showWarningNotification("Please enter your Old password");
                $('#Old_Password').focus();
                return false;
            }
            if (Pass === "") {
                showWarningNotification("Please enter your New password");
                return false;
            }

            if (CnfrmPass === "") {
                $('#confirm_password').addClass("is-invalid");
                showWarningNotification("Please confirm your New password");
                return false;
            }
            if (Pass !== CnfrmPass) {
                $('#password, #confirm_password').addClass("is-invalid");
                showWarningNotification("Passwords does not matched");
                return false;
            }
            var data = {
                OldPassword: OldPass,
                NewPassword: Pass,
                ConfirmPassword: CnfrmPass
            };

            $.ajax({
                type: 'POST',
                url: '/Home/ChangePassword',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (response) {
                    if (response.Sr == "1") {
                        Lobibox.notify('success', {
                            pauseDelayOnHover: true,
                            continueDelayOnInactiveTab: false,
                            position: 'top right',
                            icon: 'bx bx-check-circle',
                            msg: response.Msg
                        }),
                            window.setInterval(function () {
                                window.location.href = window.location.href;
                            }, 3000);
                    } else if (response.Sr == "0") {
                        showWarningNotification(response.Msg);
                    }
                    else {
                        showWarningNotification("Something went Wrong!");
                    }
                },
                error: function (xhr, textStatus, error) {
                    showWarningNotification(error);
                }
            });


        }
