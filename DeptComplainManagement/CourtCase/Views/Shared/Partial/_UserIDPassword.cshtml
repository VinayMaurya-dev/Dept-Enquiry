
@{
    Layout = null;
}
<style>
    #passwordForm a {
        font-size: var(--font-size-16);
        font-weight: var(--font-weight-400);
        letter-spacing: var(--letter-spacing-half);
        line-height: var(--line-height-150);
        text-decoration-line: underline;
        cursor: pointer
    }
</style>
<div id="passwordForm"> 
    <form action="/Home/CompUserLogin" method="post">
        <div class="form-row">
            <div class="position-relative form-group"> 
                <select class="form-control" id="UserRelatedTo" name="UserRelatedTo"></select> 
            </div>
            <div class="position-relative form-group" id="MarkedZonediv">
                <select class="form-control" id="ZoneId" name="ZoneId"></select>
            </div>
            <div class="position-relative form-group" id="Markedcirclediv">
                <select class="form-control" id="CircleId" name="CircleId"></select>
            </div>
            <div class="position-relative form-group" id="Markeddivisiondiv">
                <select class="form-control" id="DivisionId" name="DivisionId"></select>
            </div> 
            <div class="form-group form-box">
                <input type="email" id="txtUserId" name="EmailId" class="form-control" placeholder="Email Id" autocomplete="off" /> 
            </div>
            <div class="form-group form-box">
                <input type="password" id="txtPassword" name="Password" class="form-control" placeholder="Password" autocomplete="off" /> 
            </div>
            <div class="form-group form-box">
                <div class="row align-items-center">
                    <div class="col-sm-5">
                        <img id="captcha" src="/Captcha/GetCaptcha" alt="captcha" class="img-thumbnail"/>
                    </div>
                    <div class="col-sm-2">
                        <a id="reload" onclick="refreshCaptcha()">
                            <img src="~/assets/images/refresh.png" style="width:30px;margin:5px;cursor:pointer" />
                        </a>
                    </div>
                    <div class="col-sm-5">
                        <input type="text" name="captchacode" class="form-control" id="captchacode" maxlength="4" placeholder="Captcha">
                    </div>
                </div>
            </div>
            <div class="form-group mb-0">
                <input type="submit" class="btn-md w-100" id="btnLogin" value="Log In With Password" style="background: linear-gradient(to bottom, rgba(29, 58, 124, 0.8) 0%, rgba(29, 58, 124, 0.8) 100%);">
            </div>
        </div>
       
    </form>  
    <a href="javascript:void(0);" class="mt-2" onclick="showMobileInput()" id="showMobilebtn">Log In With OTP</a>
</div> 
