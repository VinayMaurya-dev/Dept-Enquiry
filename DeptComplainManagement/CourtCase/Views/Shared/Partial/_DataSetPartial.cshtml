                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                }
            }
        </div>
        <div>
            @if (Reminder != null && Reminder.Rows.Count > 0)
            {
                for (int i = 0; i < Reminder.Rows.Count; i++)
                {
                    if (c == Convert.ToInt32(Reminder.Rows[i]["SequenceCounter"]))
                    {
                        string collapseId = $"collapseSev_{i}";
                        string headingId = $"headingSev_{i}";
                        string dataTarget = $"#{collapseId}";
                        <div class="main-card mb-3 card">
                            <div class="card-body">
                                <div id="accordion4" class="accordion-wrapper mb-3">


                                    <div class="card mb-3">
                                        <div id="@headingId" class="card-header">
                                            <button type="button" data-toggle="collapse" data-target="@dataTarget"
                                                    aria-expanded="false" aria-controls="@collapseId"
                                                    class="text-left m-0 p-0 btn btn-link btn-block">
                                                <h5 class="m-0 p-0">
                                                    <b> @Reminder.Rows[i]["ActionName"].ToString()</b>
