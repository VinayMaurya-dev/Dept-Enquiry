                                                                <div class="col-md-4 mb-3">
                                                                    <div class="position-relative form-group">
                                                                        <label>अपलोड किया गया  दस्तावेज</label><br />
                                                                        <a href="@Reminder.Rows[i]["Attatchment"].ToString()" target="_blank" class="mb-2 mr-2">
