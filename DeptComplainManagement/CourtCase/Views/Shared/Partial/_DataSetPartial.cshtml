@model CourtCase.Models.ComplaintDetails
@{
    System.Data.DataSet ds = ((System.Data.DataSet)ViewBag.Replies);
    System.Data.DataTable dt = new System.Data.DataTable();
    System.Data.DataTable ft = new System.Data.DataTable();
    System.Data.DataTable it = new System.Data.DataTable();
    System.Data.DataTable aarop = new System.Data.DataTable();
    System.Data.DataTable statement = new System.Data.DataTable();
    System.Data.DataTable finalstatus = new System.Data.DataTable();
    System.Data.DataTable Reminder = new System.Data.DataTable();
    System.Data.DataTable forwardInvest = new System.Data.DataTable();
    System.Data.DataTable hearing = new System.Data.DataTable();
    System.Data.DataTable Counter = new System.Data.DataTable();
    System.Data.DataTable Revision = new System.Data.DataTable();
    System.Data.DataTable Appeal = new System.Data.DataTable();
    System.Data.DataTable finalRevAppstatus = new System.Data.DataTable();
    System.Data.DataTable Courtdata = new System.Data.DataTable();
    System.Data.DataTable Investigationdata = new System.Data.DataTable();

    if (ds != null && ds.Tables.Count > 0)
    {
        dt = ds.Tables[0];
        ft = ds.Tables[1];
        it = ds.Tables[2];
        aarop = ds.Tables[3];
        statement = ds.Tables[4];
        finalstatus = ds.Tables[5];
        Reminder = ds.Tables[6];
        forwardInvest = ds.Tables[7];
        hearing = ds.Tables[8];
        Counter = ds.Tables[9];
        Revision = ds.Tables[10];
        Appeal = ds.Tables[11];
        finalRevAppstatus = ds.Tables[12];
        Courtdata = ds.Tables[13];
        Investigationdata = ds.Tables[14];
    }
}

@if (Counter != null && Counter.Rows.Count > 0)
 {
    foreach (System.Data.DataRow counterRow in Counter.Rows)
    {
        int c = Convert.ToInt32(counterRow["SequenceCounter"]);

        <div>
            @if (it != null && it.Rows.Count > 0)
            {
                for (int i = 0; i < it.Rows.Count; i++)
                {
                    if (c == Convert.ToInt32(it.Rows[i]["SequenceCounter"]))
                    {
                        string collapseId = "collapsetwo" + i;
                        string headingId = "headingtwo" + i;
                        string dataTarget = "#" + collapseId;
                        <div class="main-card mb-3 card">
                            <div class="card-body">
                                <h5 class="card-title">पदेन जांच अधिकारी</h5>

                                <div id="accordion2" class="accordion-wrapper mb-3">


                                    <div class="card mb-3">
                                        <div id="@headingId" class="card-header">
                                            <button type="button" data-toggle="collapse" data-target="@dataTarget"
                                                    aria-expanded="false" aria-controls="@collapseId"
                                                    class="text-left m-0 p-0 btn btn-link btn-block">
                                                <h5 class="m-0 p-0">

                                                    <b>पदेन जांच अधिकारी को दिनांक @it.Rows[i]["MarkedOnDate"].ToString() को प्रश्नगत जाँच अग्रसारित किया गया |</b>
                                                    <i class="float-right pe-7s-angle-down-circle fa-1x" style="color:black;"></i>
                                                </h5>
                                            </button>
                                        </div>
                                        <div id="@collapseId" @*class="collapse"*@ data-parent="#accordion2" aria-labelledby="@headingId">
                                            <div class="card-body">
                                                <div class="media">
                                                    <div class="media-body"> 
                                                        <div class="mt-2">
                                                            <div class="form-row">
                                                                <div class="col-md-3 mb-3">
                                                                    <div class="position-relative form-group">
                                                                        <label>जांच अधिकारी कहाँ से है</label>
                                                                        <input type="text" class="form-control" readonly value="@it.Rows[i]["InvestigatingOfficerRelatedTo"].ToString()" />
                                                                    </div>
                                                                </div>

                                                                @* Zone, Circle, Division Visibility Logic *@
                                                                @{
                                                                    string relatedTo = it.Rows[i]["InvestigatingOfficerRelatedTo"].ToString();
                                                                    bool showZone = relatedTo == "Zone" || relatedTo == "Circle" || relatedTo == "Division";
                                                                    bool showCircle = relatedTo == "Circle" || relatedTo == "Division";
                                                                    bool showDivision = relatedTo == "Division";
                                                                }

                                                                @if (showZone)
                                                                {
                                                                    <div class="col-md-3 mb-3">
                                                                        <div class="position-relative form-group">
                                                                            <label>Zone</label>
                                                                            <input type="text" class="form-control" readonly value="@it.Rows[i]["InvestigatingOfficerZone"].ToString()" />
                                                                        </div>
                                                                    </div>
                                                                }

                                                                @if (showCircle)
                                                                {
                                                                    <div class="col-md-3 mb-3">
                                                                        <div class="position-relative form-group">
                                                                            <label>Circle</label>
                                                                            <input type="text" class="form-control" readonly value="@it.Rows[i]["InvestigatingOfficerCircle"].ToString()" />
                                                                        </div>
                                                                    </div>
                                                                }

                                                                @if (showDivision)
                                                                {
                                                                    <div class="col-md-3 mb-3">
                                                                        <div class="position-relative form-group">
                                                                            <label>Division</label>
                                                                            <input type="text" class="form-control" readonly value="@it.Rows[i]["InvestigatingOfficerDivision"].ToString()" />
                                                                        </div>
                                                                    </div>
                                                                }

                                                                <div class="col-md-3 mb-3">
                                                                    <div class="position-relative form-group">
                                                                        <label>अधिकारी पद का नाम</label>
                                                                        <input type="text" class="form-control" readonly value="@it.Rows[i]["InvestigatingOfficerDesignationName"].ToString()" style="font-size:14px;" />
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-3 mb-3">
                                                                    <div class="position-relative form-group">
                                                                        <label>अधिकारी का ईमेल आईडी</label>
                                                                        <input type="text" class="form-control" readonly value="@it.Rows[i]["InvestigatingOfficerName"].ToString()" id="InvestigatingOfficerName" />
                                                                    </div>
                                                                </div>

                                                                <div class="col-md-3 mb-3">
                                                                    <div class="position-relative form-group">
                                                                        <label>अधिकारी का मोबाइल नंबर</label>
                                                                        <input type="text" class="form-control" readonly value="@it.Rows[i]["InvestigatingOfficerMobile"].ToString()" />
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                }
            }
        </div> 
        <div>
                @if (aarop != null && aarop.Rows.Count > 0)
                {
                    for (int i = 0; i < aarop.Rows.Count; i++)
                    {
                        if (c == Convert.ToInt32(aarop.Rows[i]["SequenceCounter"]))
                        {
                            string collapseId = $"collapsethree_{i}";
                            string headingId = $"headingthree_{i}";
                            string dataTarget = $"#{collapseId}";
                            <div class="main-card mb-3 card">
                                <div class="card-body"> 
                                    @if (c == 2)
                                    {
                                        <h5 class="card-title">आरोप विवरण</h5>
                                        <div class="form-row">
                                            <div class="col-md-3 mb-3">
                                                <div class="form-group">
                                                    <label>आरोपों की संख्या</label>
                                                    @Html.TextBoxFor(m => m.NumberofCharges, new { @class = "form-control", @readonly = "true" })
                                                </div>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <div class="form-group">
                                                    <label>आरोप पत्र संख्या</label>
                                                    @Html.TextBoxFor(m => m.ChargeSheetNumber, new { @class = "form-control", @readonly = "true" })
                                                </div>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <div class="form-group">
                                                    <label>अपलोड किया गया आरोप पत्र</label><br />
                                                    @if (!string.IsNullOrEmpty(Model.ChargeSheetAttachment))
                                                    {
                                                        <a href="@Model.ChargeSheetAttachment.Replace("~", "")" target="_blank" class="mb-2 mr-2">
                                                            <img src="~/assets/pdf/pdf3.png" style="height:50px;" class="img-responsive" />
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a href="javascript:void(0);" class="mb-2 mr-2 disabled">
                                                            <img src="~/assets/pdf/pdf3.png" style="height:50px;" />
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <div class="form-group">
                                                    <label>आरोप पत्र निर्गत की तिथि</label>
                                                    @Html.TextBoxFor(model => model.DateOfIssueChargeSheet, new { @type = "date", @class = "form-control", @readonly = "true" })
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    <div id="accordion3" class="accordion-wrapper mb-3">


                                        <div class="card mb-3">
                                            <div id="@headingId" class="card-header">
                                                <button type="button" data-toggle="collapse" data-target="@dataTarget"
                                                        aria-expanded="false" aria-controls="@collapseId"
                                                        class="text-left m-0 p-0 btn btn-link btn-block">
                                                    <h5 class="m-0 p-0"><b>विवरण :- @(i + 1)</b></h5>
                                                    <i class="float-right pe-7s-angle-down-circle fa-1x" style="color:black;"></i>
                                                </button>
                                            </div>
                                            <div id="@collapseId" data-parent="#accordion3" aria-labelledby="@headingId">
                                                <div class="card-body">
                                                    <div class="media">
                                                        <div class="media-body">
                                                            <div class="mt-2">
                                                                <div class="form-row">
                                                                    <div class="col-md-12 mb-3">
                                                                        <div class="position-relative form-group">
                                                                            <label for="validationCustomUsername">आरोप विवरण</label>
                                                                            <textarea class="form-control" readonly rows="6">@aarop.Rows[i]["Aarop_Details"].ToString()</textarea>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        <div>
            @if (dt != null && dt.Rows.Count > 0)
            {
                for (int i = 0; i < dt.Rows.Count; i++)
                {
                    if (c == Convert.ToInt32(dt.Rows[i]["SequenceCounter"]))
                    {
                        string collapseId = $"collapsefour_{i}";
                        string headingId = $"headingfour_{i}";
                        string dataTarget = $"#{collapseId}";
