            {
                for (int i = 0; i < forwardInvest.Rows.Count; i++)
                {
                    if (c == Convert.ToInt32(forwardInvest.Rows[i]["SequenceCounter"]))
                    {
                        string collapseId = $"collapseEight_{i}";
                        string headingId = $"headingEight_{i}";
                        string dataTarget = $"#{collapseId}";
                        <div class="main-card mb-3 card">
                            <div class="card-body">
                                <div id="accordion8" class="accordion-wrapper mb-3">


                                    <div class="card mb-3">
                                        <div id="@headingId" class="card-header">
                                            <button type="button" data-toggle="collapse" data-target="@dataTarget"
                                                    aria-expanded="false" aria-controls="@collapseId"
                                                    class="text-left m-0 p-0 btn btn-link btn-block">
