
@{
    Layout = null;
}
<style>
    #mobileForm a {
        font-size: var(--font-size-16);
        font-weight: var(--font-weight-400);
        letter-spacing: var(--letter-spacing-half);
        line-height: var(--line-height-150);
        text-decoration-line: underline;
        cursor: pointer
    }

    i.flaticon-user-1 {
        margin-top: 8px;
    }
</style>
<div id="mobileForm" class="mobile-form-container" style="display:none;">
    <div class="form-row">
        <div class="position-relative form-group">
            <select class="form-control" id="MobileUserRelatedTo" name="UserRelatedTo"></select>
        </div>
        <div class="position-relative form-group" id="MobileMarkedZonediv">
            <select class="form-control" id="MobileZoneId" name="ZoneId"></select>
        </div>
        <div class="position-relative form-group" id="MobileMarkedcirclediv">
            <select class="form-control" id="MobileCircleId" name="CircleId"></select>
        </div>
        <div class="position-relative form-group" id="MobileMarkeddivisiondiv">
            <select class="form-control" id="MobileDivisionId" name="DivisionId"></select>
        </div>
        <div class="form-group form-box">
            <input type="text" id="txtMobileNo" name="MobileNo" class="form-control" placeholder="Mobile (Log In With OTP)" autocomplete="off" maxlength="10" />
        </div>
        <div class="form-group mb-0">
            <input type="button" class="btn-md w-100 send-otp-btn" onclick="ValidateNumber();" id="btnSendOTP" value="Generate OTP">
        </div>
    </div>
    <div class="form-group text-center mt-3">
        <a href="javascript:void(0);" onclick="showPasswordInput()">Log In With Password</a>
    </div>

</div>
