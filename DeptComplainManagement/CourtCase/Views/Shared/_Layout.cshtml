                overflow-x: hidden;
            }

        #scr-vtr-dynamic table thead {
            position: sticky;
            top: 0;
        }

        table.dataTable th,
        table.dataTable td {
            width: 150px;
            max-width: 150px;
            word-wrap: break-word;
        }

        div.dataTables_wrapper {
            max-width: 800px;
            margin: 0 auto;
        }
    </style>
