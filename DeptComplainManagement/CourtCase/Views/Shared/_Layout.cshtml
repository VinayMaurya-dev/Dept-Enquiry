    <script type="text/javascript" defer src="~/main.d810cf0ae7f39f28f336.js?v=2.5"></script>
    <script>
            $(document).on({ contextmenu: function (e) { e.preventDefault() } }); $(document).on("keydown", function (e) { if (e.ctrlKey) { } }); document.addEventListener("keydown", function (e) { if (e.key === "F12") { e.preventDefault() } }); $(document).keydown(function (event) { if (event.key === "I" || event.ctrlKey && event.shiftKey && event.key === "I") { event.preventDefault() } }); $(document).keydown(function (e) { if (e.key === "F12" || e.ctrlKey && e.shiftKey && e.key === "I") { e.preventDefault() } });
    </script>  
