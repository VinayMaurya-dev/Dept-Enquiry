    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const preloader = document.querySelector(".loader-spinner");

            if (!preloader) {
                console.error("Preloader element not found.");
                return;
            }

            // Always show the loader for 2 seconds, then hide it
            setTimeout(() => {
                showLoader();
                preloader.classList.add("loader-spinner-deactivate");
            }, 2000);
        });

        function showLoader() {
            // Append a custom loader animation (image or other elements)
            $('.spinner').fadeTo('slow', .8);
            $('.spinner').append('<div style="background-color:black;position: fixed;top:0;left:0;width: 100%;height:100%;z-index:1000000001;-moz-opacity: 0.8;opacity:.80;filter: alpha(opacity=80);"><img src="/Content/assets/img/loader.gif" style="background-color:black;position:fixed; top:33%; left:41%;"/></div>');
        }

        function hideLoader() { 
            $('.spinner').fadeOut('slow');
        } 
         
    </script>
    <style>
        .buttons-colvis {
            background: teal !important;
            color: white !important;
            border-radius: 16px !important;
        }

        .toast-success {
