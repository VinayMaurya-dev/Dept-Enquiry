    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let dateInput = document.querySelector("[data-toggle='datepicker-month']");
            if (dateInput) {
                dateInput.addEventListener("input", function (e) {
                    this.value = this.value.replace(/[^0-9\/]/g, ""); // Allows only numbers and "/"
                });
            }
        });
    </script>

    <script>
        var btnloader = {
            load: function (button) {
                $(button).append('<span class="loadSpan spinner-border spinner-border-sm" role="status" aria-hidden="true" style="height:20px;width:20px; line-height:20px;margin-left:10px;"></span>');
                $(button).prop("disabled", true);
            },
            remove: function (button) {
                $(button).find('.loadSpan').remove();
                $(button).prop("disabled", false);
            }
        };

        function reloadCSS() {
            var links = document.querySelectorAll("link[rel='stylesheet']");
            links.forEach(link => {
                var href = link.href.split("?")[0];
                link.href = href + "?v=" + (Math.floor(Math.random() * 90000) + 10000);
            });
        }
        reloadCSS();

        $(document).ready(function () {
            window.setInterval(function () {
                $('.app-container').addClass('closed-sidebar');
                $('.hamburger').addClass('is-active');
            }, 100);


        });
        new DataTable('.example', {
            layout: {
                topStart: {
                    buttons: [
                        'print',
                        {
                            extend: 'excel',
                            exportOptions: {
                                columns: ':visible'
                            }
                        },
                        'colvis'
                    ]
                }
            }
        });
        function GetSuccessMsg(Id) {
            Lobibox.notify("success", {
                position: "top right",
                icon: "bx bx-check-circle",
                msg: Id
            });
        }
        function GetMsg(Id) {
            Lobibox.notify("warning", {
                pauseDelayOnHover: true,
                size: "mini",
                rounded: true,
                delayIndicator: false,
                icon: "bx bx-check-warning",
                continueDelayOnInactiveTab: false,
                position: "top right",
                msg: Id
            });
        }
    </script>
