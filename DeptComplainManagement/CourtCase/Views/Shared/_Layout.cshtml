        }

        #scr-vtr-dynamic thead {
            background: #3a4baf;
            color: white;
        }

        .mm-active {
            max-height: 300px;
            overflow-y: auto;
            overflow-x: hidden;
            width: 255px;
            display: flex;
            flex-direction: column;
        }

        ul.mm-collapse::-webkit-scrollbar {
            width: 6px;
        }

        ul.mm-collapse::-webkit-scrollbar-thumb {
            background-color: #888;
            border-radius: 3px;
        }

        ul.mm-collapse::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ul.mm-collapse {
            max-height: 300px;
            overflow-y: auto;
            overflow-x: hidden;
            white-space: nowrap;
        }

        .scrollbar-sidebar {
            overflow-x: hidden;
        }

        .vertical-nav-menu li {
            position: relative;
        }

