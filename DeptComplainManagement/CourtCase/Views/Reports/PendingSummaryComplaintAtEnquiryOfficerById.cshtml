@using CourtCase.Filters
@{
    ViewBag.Title = "PendingSummaryComplaintAtEnquiryOfficerById";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string op = ViewBag.op as string;
}
@{

    string Title = "";

    if (op == "Total")
    {
        Title = "कुल पत्रावलियों की संख्या";
    }
    else if (op == "Urban")
    {
        Title = "उ0प्र0 जल निगम (नगरीय) अन्तर्गत प्रचलित पत्रावलियों की संख्या";
    }
    else if (op == "Rural")
    {
        Title = "उ0प्र0 जल निगम (ग्रामीण) अन्तर्गत प्रचलित पत्रावलियों की संख्या";
    }
    else if (op == "TotalSankhya")
    {
        Title = "कुल पत्रावलियों की संख्या";
    }
    else if (op == "0-6")
    {
        Title = "06 माह के भीतर";
    }
    else if (op == "06-12")
    {
        Title = "06 माह से 01 वर्ष";
    }
    else if (op == "12-24")
    {
        Title = "01 वर्ष से 02 वर्ष";
    }
    else if (op == "24")
    {
        Title = "02 वर्ष से अधिक";
    }
    else if (op == "pending")
    {
        Title = "निलंबित कार्मिको की संख्या";
    }
    else if (op == "AaropShankya")
    {
        Title = "आरोप पत्र निर्गमन की संख्या";
    }

    else if (op == "JhanchAkhya")
    {
        Title = "जाँच आख्या प्राप्त होने की संख्या";
    }

    else if (op == "decicision")
    {
        Title = "निर्णय हेतु प्रेषित पत्रावलियां";
    }

    else if (op == "recivepersonal")
    {
        Title = "व्यक्तिगत सुनवाई  एवं अभ्यावेदन प्राप्त होने के  स्तर पर";
    }

    else if (op == "sankhya1")
    {
        Title = "निर्णित पत्रावलियां की संख्या";
    }

}


<div class="app-main__inner">
    <div class="app-page-title app-page-title-simple">
        <div class="page-title-wrapper">
            <div class="page-title-heading">
                <div>
                    <div class="page-title-head center-elem">
                        <span class="d-inline-block pr-2">
                            <i class="lnr-apartment opacity-6"></i>
                        </span>
                        <span class="d-inline-block"> शिकायत अनुभाग के अन्तर्गत प्रचलित पत्रावलियों में जांच अधिकारी से अप्राप्त जांच आख्या का विवरण-</span>
                    </div>
                    <div class="page-title-subheading opacity-10">
                        <nav class="" aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <button type="button" onclick="history.back()" value="BACK" class="btn btn-primary mybackbutton"><i class="fa fa-arrow-left" aria-hidden="true"> Back</i></button>
                                </li>

                                <li class="active breadcrumb-item" aria-current="page">
                                    @Title

                                </li>
                            </ol>
                        </nav>

                    </div>

                </div>
            </div>

        </div>
    </div>
    <div class="main-card mb-3 card">
        <div class="card-body">
            <div class="row">
                <div class="mb-2 col-md-2">
                    <label class="form-label">दिनांक से</label>
                    <input type="date" class="form-control form-control-sm" placeholder="YYYY-MM-DD" id="Fromdate" />

                </div>
                <div class="mb-2 col-md-2">
                    <label class="form-label">दिनांक तक</label>
                    <input type="date" class="form-control form-control-sm" placeholder="YYYY-MM-DD" id="todate" />
                </div>
                <div class="col-md-2 mb-3">
                    <div class="position-relative form-group">
                        <label for="exampleAddress" class="">
                            ग्रामीण / नगरीय
                        </label><br />

                        <select class="form-control form-control-sm" id="R_U" name="R_U">
                            <option value="-1">Choose Option</option>
                            <option value="Rural">Rural</option>
                            <option value="Urban">Urban</option>

                        </select>
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <div class="position-relative form-group">
                        <label for="exampleAddress" class="">कार्मिक का नाम </label><br />
                        <input type="text" class="form-control form-control-sm" id="ComplainantName" name="ComplainantName" />
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <div class="position-relative form-group">
                        <label for="exampleAddress" class="">वर्तमान कार्यरत कार्यालय </label>
                        <select class="form-control form-control-sm" id="ComplaintRelatedTo" name="ComplaintRelatedTo"></select>
                    </div>
                </div>

                <div class="col-md-2 mb-3" id="zoneddl">
                    <div class="position-relative form-group">
                        <label for="validationCustomUsername">वर्तमान ज़ोन </label>

                        <select class="form-control form-control-sm zone" id="ComplaintRelatedZoneId" name="ComplaintRelatedZoneId"></select>
                    </div>

                </div>

                <div class="col-md-2 mb-3" id="circleddl">
                    <div class="position-relative form-group">
                        <label for="validationCustomUsername">वर्तमान सर्किल </label>
                        <select class="form-control form-control-sm circle" id="ComplaintRelatedCircleId" name="ComplaintRelatedCircleId"></select>

                    </div>

                </div>
                <div class="col-md-2 mb-3" id="ddldivision">
                    <div class="position-relative form-group">
                        <label for="validationCustomUsername">वर्तमान डिवीज़न </label>
                        <select class="form-control form-control-sm" id="ComplaintRelatedDivisionId" name="ComplaintRelatedDivisionId"></select>

                    </div>

                </div>

                <div class="mb-2 col-md-2" style="margin-top:25px;">
                    <button class="btn rounded-pill btn-success" type="button" id="btnSearch">
                        <i class="fas fa-search"></i> खोजे
                    </button>
                </div>
            </div>
        </div>
    </div>
    <center>

        <div class="main-card mb-3 card">
            <div class="card-body">
                <div id="step-1">
                    <div class="form-row" id="divDetails">
                        <div class="table-responsive" style="margin-top:15px;">
                            @if (Model != null)
                            {
                                System.Data.DataSet ds = ((System.Data.DataSet)Model);
                                System.Data.DataTable dt = new System.Data.DataTable();

                                if (ds.Tables.Count > 0 && ds != null)
                                {
                                    dt = ds.Tables[0];
                                }
                                <table id="scr-vtr-dynamic" class="example table table-hover table-striped table-bordered mb-0" style="width:100%;">
                                    <thead>
                                        <tr>
                                            @foreach (System.Data.DataColumn col in dt.Columns)
                                            {

                                                <th style="text-align:center;">@Html.Raw(col.ColumnName)</th>
                                            }
                                        </tr>

                                    </thead>

                                    <tbody>
                                        @foreach (System.Data.DataRow row in dt.Rows)
                                        {

                                            <tr>

                                                @foreach (System.Data.DataColumn column in dt.Columns)
                                                {
                                                    var cellValue = row[column].ToString();
                                                    if (column.ColumnName == "कार्रवाई")
                                                    {
                                                        <td>
                                                            @Html.EncodedActionLink("देखें",
                                                                  "DepartmentalComplaintDetails",
                                                                  "Reports",
                                                                  new { ComplaintNo = cellValue },
                                                                  new { @class = "btn-transition btn btn-outline btn-primary" },
                                                                  "fa fa-eye"
                                                              )
                                                        </td>
                                                    }
                                                    else
                                                    {

                                                        <td style="text-align:center;">@Html.Raw(cellValue)</td>
                                                    }
                                                }
                                            </tr>


                                        }

                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </center>
</div>

<script src="~/Content/assets/js/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $('#zoneddl,#circleddl,#ddldivision').hide();
        $("#ComplaintRelatedTo").change(function () {
            var mrk = $(this).val().trim();
            if (mrk == "HQ") {
                $('#zoneddl,#circleddl,#ddldivision').hide();
                $("#ComplaintRelatedZoneId").val('-1').trigger('change');
                $("#ComplaintRelatedCircleId").val('-1').trigger('change');
                $("#ComplaintRelatedDivisionId").val('-1').trigger('change');
            }
            else if (mrk == "Z") {
                $('#circleddl,#ddldivision').hide();
                $('#zoneddl').show();
                bindZone('ComplaintRelatedZoneId', -1);
                $("#ComplaintRelatedCircleId").val('-1').trigger('change');
                $("#ComplaintRelatedDivisionId").val('-1').trigger('change');
            }
            else if (mrk == "C") {
                $('#ddldivision').hide();
                $('#zoneddl,#circleddl').show();
                bindZone('ComplaintRelatedZoneId', -1);
                bindCircle('ComplaintRelatedCircleId', -1, -1);
                $("#ComplaintRelatedDivisionId").val('-1').trigger('change');
            }
            else if (mrk == "D") {
                $('#zoneddl,#circleddl,#ddldivision').show();
                bindZone('ComplaintRelatedZoneId', -1);
                bindCircle('ComplaintRelatedCircleId', -1, -1);
                bindDivision('ComplaintRelatedDivisionId', -1, -1, -1);
            }
            else {
                $('#zoneddl,#circleddl,#ddldivision').hide();
            }
            BindComplaintDesignation('PreviousComplaintDesignationId', -1, mrk);


        });
        $("#ComplaintRelatedZoneId").change(function () {
            var zone = $(this).val();
            bindCircle("ComplaintRelatedCircleId", -1, zone);
        });

        $("#ComplaintRelatedCircleId").change(function () {
            var selectedCircle = $('#ComplaintRelatedCircleId').val();
            var zone = $("#ComplaintRelatedZoneId").val();
            bindDivision("ComplaintRelatedDivisionId", -1, zone, selectedCircle);

        });
        BindComplaintDesignation('PreviousComplaintDesignationId', -1);
        BindComplaintRelatedTo('ComplaintRelatedTo', -1);
        bindZone('ComplaintRelatedZoneId', -1);
        bindCircle('ComplaintRelatedCircleId', -1, -1);
        bindDivision('ComplaintRelatedDivisionId', -1, -1, -1);
        function BindComplaintDesignation(ids, defaultSelectionValues, RelatedTo) {
            // Validate and set default selection values
            if (['-1', '0', '', null, undefined].includes(defaultSelectionValues)) {
                defaultSelectionValues = '-1';
            }

            const idArray = ids.split(',');

            var obj = new Object();
            obj.Action = "bindCompDesignationsNew";
            obj.CaseRelatedTo = RelatedTo;
            $.ajax({
                type: 'POST',
                url: '/DropdownBinder/fillDropdown',
                data: { obj: obj },
                success: function (Data) {
                    idArray.forEach(id => {
                        const ddl = $('#' + id.trim());
                        ddl.empty(); // Clear the existing options

                        ddl.append($('<option/>', {
                            value: "-1",
                            text: "Choose option"
                        }));

                        Data.forEach(rowData => {
                            ddl.append($('<option/>', {
                                value: rowData.id,
                                text: rowData.value
                            }));
                        });

                        if (defaultSelectionValues !== '-1') {
                            ddl.val(defaultSelectionValues);
                        }
                    });
                },
                error: function (errorData) {
                    console.error('Error occurred:', errorData);
                }
            });
        }
        function BindComplaintRelatedTo(ids, defaultSelectionValues = '-1') {
            // Ensure defaultSelectionValues is correctly assigned
            if (['-1', '0', '', null, undefined].includes(defaultSelectionValues)) {
                defaultSelectionValues = '-1';
            }

            // Parse the provided `ids` string into an array
            const idArray = ids.split(',');

            // Object to send with the AJAX request
            const obj = { Action: "bindDepartmentalRoles" };
            $.ajax({
                type: 'POST',
                url: '/DropdownBinder/fillDropdown',
                data: obj,
                success: function (Data) {
                    idArray.forEach(id => {
                        const ddl = $('#' + id.trim());
                        ddl.empty();
                        ddl.append($('<option/>', {
                            value: "-1",
                            text: "Choose option"
                        }));

                        // Populate dropdown with data
                        Data.forEach(rowData => {
                            ddl.append($('<option/>', {
                                value: rowData.id,
                                text: rowData.value
                            }));
                        });

                        // Set default value if applicable
                        if (defaultSelectionValues !== '-1') {
                            ddl.val(defaultSelectionValues);
                        }
                    });
                },
                error: function (errorData) {
                    console.error("Error occurred while binding dropdown:", errorData);
                }
            });
        }
        function bindZone(id, defaultSelectionValues) {

            defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
            if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
                defaultSelectionValues = '-1';
            }
            var obj = new Object();
            obj.Action = "bindZone";

            $.ajax({
                type: 'POST',
                url: '/DropdownBinder/fillDropdown',
                data: { Action: obj.Action },
                success: function (Data) {
                    var ddl = $('#' + id);
                    ddl.empty();
                    ddl.append($('<option/>', {
                        value: "-1",
                        text: "Choose option "
                    }));

                    $.each(Data, function (index, rowData) {
                        ddl.append($('<option/>', {
                            value: rowData.id,
                            text: rowData.value
                        }));
                    });
                    ddl.val(defaultSelectionValues);
                },
                error: function (errorData) {
                    console.log(errorData);
                }
            });

        }
        function bindCircle(id, defaultSelectionValues, ZoneId) {

            defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
            if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
                defaultSelectionValues = '-1';
            }
            var obj = new Object();
            obj.Action = "bindCircle";
            obj.ZoneId = ZoneId;

            $.ajax({
                type: 'POST',
                url: '/DropdownBinder/fillDropdown',
                data: { Action: obj.Action, ZoneId: obj.ZoneId },
                success: function (Data) {
                    var ddl = $('#' + id);
                    ddl.empty();
                    ddl.append($('<option/>', {
                        value: "-1",
                        text: "Choose option "
                    }));

                    $.each(Data, function (index, rowData) {
                        ddl.append($('<option/>', {
                            value: rowData.id,
                            text: rowData.value
                        }));
                    });
                    ddl.val(defaultSelectionValues);
                },
                error: function (errorData) {
                    console.log(errorData);
                }
            });

        }
        function bindDivision(id, defaultSelectionValues, ZoneId, CircleId) {

            defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
            if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
                defaultSelectionValues = '-1';
            }
            var obj = new Object();
            obj.Action = "bindDivision";
            obj.ZoneId = ZoneId,
                obj.CircleId = CircleId

            $.ajax({
                type: 'POST',
                url: '/DropdownBinder/fillDropdown',
                data: { Action: obj.Action, ZoneId: obj.ZoneId, CircleId: obj.CircleId },
                success: function (Data) {
                    var ddl = $('#' + id);
                    ddl.empty();
                    ddl.append($('<option/>', {
                        value: "-1",
                        text: "Choose option "
                    }));

                    $.each(Data, function (index, rowData) {
                        ddl.append($('<option/>', {
                            value: rowData.id,
                            text: rowData.value
                        }));
                    });
                    ddl.val(defaultSelectionValues);
                },
                error: function (errorData) {
                    console.log(errorData);
                }
            });
        }
        $("#btnSearch").click(function () {
            debugger;
            var Fromdate = $("#Fromdate").val();
            var todate = $("#todate").val();
            var ComplaintRelatedTo = $("#ComplaintRelatedTo").val();
            var ComplaintRelatedZoneId = $("#ComplaintRelatedZoneId").val();
            var ComplaintRelatedCircleId = $("#ComplaintRelatedCircleId").val();
            var ComplaintRelatedDivisionId = $("#ComplaintRelatedDivisionId").val();
            var ComplainantName = $("#ComplainantName").val();
            var R_U = $("#R_U").val();


            var formData = {
                Id: '@ViewBag.Id',
                OptionalPr:'@ViewBag.op',
                Fromdate: Fromdate,
                todate: todate,
                ComplaintRelatedTo: ComplaintRelatedTo,
                ComplaintRelatedZoneId: ComplaintRelatedZoneId,
                ComplaintRelatedCircleId: ComplaintRelatedCircleId,
                ComplaintRelatedDivisionId: ComplaintRelatedDivisionId,
                ComplainantName: ComplainantName,
                R_U: R_U,
            };

            $.post("/Reports/PendingSummaryComplaintAtEnquiryOfficerById", formData, function (response) {

                var htmlNew = response;
                $("#divDetails").html($(htmlNew).find("#divDetails").html());

                // Clear and destroy previous DataTable before initializing a new one
                if ($.fn.DataTable.isDataTable('.example')) {
                    $('.example').DataTable().clear().destroy();
                }

                // Initialize the DataTable after replacing the content
                new DataTable('.example', { // Fixed the selector to match the table
                    layout: {
                        topStart: {
                            buttons: [
                                'print',
                                {
                                    extend: 'excel',
                                    exportOptions: {
                                        columns: ':visible'
                                    }
                                },
                                'colvis'
                            ]
                        }
                    }
                });

            });
        });
    });
</script>

