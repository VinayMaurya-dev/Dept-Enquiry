<script type="text/javascript">

    $(document).ready(function () {
        var msg = '@TempData["msg"]';
        if (msg == "Update") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.success('डेटा सफलतापूर्वक अपडेट हो गया!');
        }
        else if (msg == "error") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.error('एरर!');
        }
        else if (msg == "inserted") {
            toastr.options = {
                "closeButton": true,
                "timeout": 1000,
                "progressBar": true,
                "positionClass": "toast-top-right"
            }
            toastr.success('डेटा सफलतापूर्वक सेव हो गया!');
        }

        $('#reminderdiv').hide();
        $('#higherofficerdiv').hide();
        $('#FinalStatusShowcausediv').hide();
        bindDesignationsMarkedOfficer('ForwadingHigherOfficerOfficer', -1, -1);
        $('#reminderbtn,#Answerbtn').click(function () {
            const myDiv = document.getElementById('reminderdiv');
            var currentID = $(this).attr("id");
            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
                $("#ActionName").empty();
                if (currentID === 'reminderbtn') {
                    $("#ActionName").val('कारण बताओ नोटिस प्रस्तुत करने हेतु कार्मिक को प्रेषित अनुस्मारक पत्र का विवरण')
                    $("#Flag").val('1');
                }
                else if (currentID === 'Answerbtn') {
                    $("#ActionName").val('कारण बताओ नोटिस प्रस्तुत करने हेतु कार्मिक द्वारा प्राप्त जवाब का विवरण');
                    $("#Flag").val('2');
                }
                $("#ActionName").prop("readonly", true);
            } else {
                myDiv.style.display = 'none';
            }
        });


        $('#higherofficerbtn').click(function () {
            const myDiv = document.getElementById('higherofficerdiv');


            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
            }
            $('#reminderdiv').hide();
        });

        $('#addFinalStatusShowcausebtn').click(function () {
            const myDiv = document.getElementById('FinalStatusShowcausediv'); 
            if (myDiv.style.display === 'none') {
                myDiv.style.display = 'block';
            } else {
                myDiv.style.display = 'none';
            }
            $('#reminderdiv').hide();
            $('#higherofficerdiv').hide();
        });
    });
       function bindDesignationsMarkedOfficer(id, defaultSelectionValues, RoleTypeId) {

       defaultSelectionValues = typeof defaultSelectionValues !== 'undefined' ? defaultSelectionValues : '';
       if (defaultSelectionValues == -1 || defaultSelectionValues == 0 || defaultSelectionValues == '-1' || defaultSelectionValues == '') {
           defaultSelectionValues = '-1';
       }
       var obj = new Object();
       obj.Action = "bindAlottingDesignationsSELevel";
       obj.RoleTypeId = RoleTypeId;


       $.ajax({
           type: 'POST',
           url: '/DropdownBinder/fillDropdown',
           data: { Action: obj.Action, RoleTypeId: obj.RoleTypeId },
           success: function (Data) {
               var ddl = $('#' + id);
               ddl.empty();
               ddl.append($('<option/>', {
                   value: "-1",
                   text: "Choose option "
               }));

               $.each(Data, function (index, rowData) {
                   if (rowData.id != '@Session["UserNumber"].ToString()') {
                       ddl.append($('<option/>', {
                           value: rowData.id,
                           text: rowData.value
                       }));
                   }

               });
               // ddl.val(defaultSelectionValues);
           },
           error: function (errorData) {
               console.log(errorData);
           }
       });

}
</script> 

 

